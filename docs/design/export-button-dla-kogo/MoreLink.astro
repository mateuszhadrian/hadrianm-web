---
/**
 * MoreLink.astro — sekcyjny button „więcej” (wariant Solid)
 * hadrianm.pl · akcent #FF5A47 · font Archivo Variable
 *
 * Prowadzi ze strony głównej (pierwsza klatka sekcji) na dedykowaną
 * podstronę z pełną animacją, np. /dla-kogo.
 *
 * Użycie:
 *   import MoreLink from '@/components/MoreLink.astro';
 *   <MoreLink href="/dla-kogo" />
 *   <MoreLink href="/oferta" label="Zobacz ofertę" />
 */
interface Props {
  href: string;
  label?: string;
  class?: string;
}
const { href, label = 'Zobacz więcej', class: className } = Astro.props;
---

<a href={href} class:list={['more-link', className]}>
  <span class="more-link__label">{label}</span>
  <span class="more-link__arrow" aria-hidden="true">→</span>
</a>

<style>
  .more-link {
    /* tokeny — podłącz pod swój theme, jeśli chcesz */
    --more-accent: #ff5a47;
    --more-accent-hover: #ff6e5d;
    --more-ink: #120a09;

    display: inline-flex;
    align-items: center;
    gap: 0.75rem; /* 12px */
    padding: 1rem 1.875rem; /* 16px 30px → tap target ~52px */
    border-radius: 8px;

    background: var(--more-accent);
    color: var(--more-ink);
    font-family: 'Archivo Variable', 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: 1rem; /* 16px */
    line-height: 1;
    letter-spacing: 0.005em;
    text-decoration: none;
    white-space: nowrap;

    box-shadow: 0 12px 28px rgba(255, 90, 71, 0.2);
    transition:
      background 0.28s ease,
      transform 0.28s ease,
      box-shadow 0.28s ease;
  }

  .more-link__arrow {
    display: inline-block;
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .more-link:hover {
    background: var(--more-accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 18px 38px rgba(255, 90, 71, 0.34);
  }
  .more-link:hover .more-link__arrow {
    transform: translateX(6px);
  }

  /* dostępność — projekt ma testy axe/a11y */
  .more-link:focus-visible {
    outline: 2px solid var(--more-accent-hover);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .more-link,
    .more-link__arrow {
      transition: none;
    }
    .more-link:hover {
      transform: none;
    }
  }
</style>
