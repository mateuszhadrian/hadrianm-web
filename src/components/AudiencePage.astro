---
// Podstrona „Dla kogo" (PL: /dla-kogo/, EN: /en/who-its-for/) — pełna
// animowana sekcja Audience przeniesiona ze strony głównej (tam została
// statyczna zajawka); plan: docs/analiza-podstrona-dla-kogo.md. Wzorzec
// chrome'u strony = WorkIndexPage.astro (BackButton w miejscu brandu,
// współdzielony Footer, jedna statyczna warstwa ambientu blue), ale scroll
// w trybie "desktop": Lenis na desktopie (scena pinned+scrub+snap ma czuć
// się identycznie jak wcześniej na stronie głównej), mobile NATYWNIE —
// gałąź mobile to flow + reveale once:true, Lenis nic tam nie wnosi.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/navbar/Navbar.astro";
import AmbientBackground from "@/components/backgrounds/AmbientBackground.astro";
import Audience from "@/components/sections/audience/Audience.astro";
import BackButton from "@/components/ui/BackButton.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations, type Lang } from "@/i18n/utils";
import { AUDIENCE_PATH, HOME_PATH } from "@/lib/routes";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  title={t("audiencePage.title")}
  lang={lang}
  description={t("audiencePage.description")}
  alternates={AUDIENCE_PATH}
  smoothScroll="desktop"
>
  <div class="akp-bg" aria-hidden="true">
    <AmbientBackground variant="blue" />
  </div>

  <Navbar lang={lang} langHrefs={AUDIENCE_PATH} showBrand={false} />

  {
    /* „Wstecz" w miejscu brandu — CELOWO poza barem navbara: fixed, więc nie
       chowa się razem z nim przy scrollu; działa jak wstecz przeglądarki
       (globalny mechanizm a[data-back], fallback → strona główna). Wrapper,
       nie klasa na komponencie: scoped CSS (strategia atrybutowa) nie łapie
       elementów renderowanych przez komponent potomny. */
  }
  <div class="akp-back">
    <BackButton href={HOME_PATH[lang]} label={t("audiencePage.back")} />
  </div>

  <main class="akp">
    <Audience lang={lang} variant="full" />
  </main>

  {/* Współdzielony footer strony (ten sam co finał strony głównej). */}
  <div class="akp-foot">
    <Footer lang={lang} />
  </div>
</BaseLayout>

<style>
  :global(body) {
    background: #000;
  }

  /* Jedna statyczna warstwa ambientu — bez crossfade'u strony głównej
     (podczas jazdy przez sekcję na głównej tłem był wariant blue). */
  .akp-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: #000;
    pointer-events: none;
  }

  /* Pozycja = slot brandu w navbarze (te same clampy paddingu paska);
     korekta -12px centruje 46-px kółko na linii treści paska. z-index nad
     nav-root (50), bo przycisk ma być widoczny ZAWSZE — także gdy pasek
     schowa się przy scrollu w dół. */
  .akp-back {
    position: fixed;
    z-index: 60;
    left: clamp(1.25rem, 4vw, 2.75rem);
    top: calc(clamp(1.25rem, 3.2vh, 1.9rem) - 12px);
  }

  .akp {
    position: relative;
    z-index: 1;
  }

  /* ── Stopka: kontener współdzielonego Footer.astro (szerokość jak na
     /realizacje/; sam footer jest bezmarginesowy — rodzic kontroluje layout) ── */
  .akp-foot {
    position: relative;
    z-index: 1;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 5vw 42px;
  }
</style>
