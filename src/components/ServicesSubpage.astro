---
// Podstrony sekcji „Oferta" (plany: docs/analiza-podstrony-oferta.md +
// docs/analiza-podstrona-oferta-hub.md): /oferta/ (EN /en/services/) =
// wariant "hub" (rozgałęźnik: wstęp + karty Pakiety/Proces),
// /proces-wspolpracy/ (EN /en/process/) = wariant "process" i /pakiety/
// (EN /en/packages/) = wariant "packages" — sekcja przeniesiona ze strony
// głównej (tam zostało intro-zajawka z parą CTA). Wzorzec chrome'u strony
// = AudiencePage.astro (BackButton w miejscu brandu, współdzielony Footer,
// jedna statyczna warstwa ambientu — tu RED, jak tło sekcji na głównej),
// scroll w trybie "desktop": Lenis na desktopie (scrub nici/intro czuje się
// jak na głównej), mobile NATYWNIE (flow + toggleClass, Lenis nic nie
// wnosi). Wyjątek hub: strona 1-ekranowa bez scen scrubowanych — scroll
// w pełni NATYWNY (smoothScroll=false, wzorzec /realizacje/).
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/navbar/Navbar.astro";
import AmbientBackground from "@/components/backgrounds/AmbientBackground.astro";
import Services from "@/components/sections/services/Services.astro";
import BackButton from "@/components/ui/BackButton.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations, type Lang } from "@/i18n/utils";
import {
  HOME_PATH,
  SERVICES_PACKAGES_PATH,
  SERVICES_PATH,
  SERVICES_PROCESS_PATH,
} from "@/lib/routes";

interface Props {
  lang: Lang;
  kind: "hub" | "process" | "packages";
}
const { lang, kind } = Astro.props;
const t = useTranslations(lang);

const paths =
  kind === "hub"
    ? SERVICES_PATH
    : kind === "process"
      ? SERVICES_PROCESS_PATH
      : SERVICES_PACKAGES_PATH;
// t() wymaga literałów kluczy (typ UiKey) — dobór per wariant zamiast
// składania stringów.
const copy =
  kind === "hub"
    ? {
        title: t("servicesPage.title"),
        description: t("servicesPage.description"),
        back: t("servicesPage.back"),
      }
    : kind === "process"
      ? {
          title: t("processPage.title"),
          description: t("processPage.description"),
          back: t("processPage.back"),
        }
      : {
          title: t("packagesPage.title"),
          description: t("packagesPage.description"),
          back: t("packagesPage.back"),
        };
---

<BaseLayout
  title={copy.title}
  lang={lang}
  description={copy.description}
  alternates={paths}
  smoothScroll={kind === "hub" ? false : "desktop"}
>
  <div class="osp-bg" aria-hidden="true">
    <AmbientBackground variant="red" />
  </div>

  <Navbar lang={lang} langHrefs={paths} showBrand={false} />

  {
    /* „Wstecz" w miejscu brandu — CELOWO poza barem navbara: fixed, więc nie
       chowa się razem z nim przy scrollu; działa jak wstecz przeglądarki
       (globalny mechanizm a[data-back], fallback → strona główna). Wrapper,
       nie klasa na komponencie: scoped CSS (strategia atrybutowa) nie łapie
       elementów renderowanych przez komponent potomny. */
  }
  <div class="osp-back">
    <BackButton href={HOME_PATH[lang]} label={copy.back} />
  </div>

  <main class="osp">
    <Services lang={lang} variant={kind} />
  </main>

  {/* Współdzielony footer strony (ten sam co finał strony głównej). */}
  <div class="osp-foot">
    <Footer lang={lang} />
  </div>
</BaseLayout>

<style>
  :global(body) {
    background: #000;
  }

  /* Jedna statyczna warstwa ambientu — bez crossfade'u strony głównej
     (podczas jazdy przez sekcję na głównej tłem był wariant red). */
  .osp-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: #000;
    pointer-events: none;
  }

  /* Pozycja = slot brandu w navbarze (te same clampy paddingu paska);
     korekta -12px centruje 46-px kółko na linii treści paska. z-index nad
     nav-root (50), bo przycisk ma być widoczny ZAWSZE — także gdy pasek
     schowa się przy scrollu w dół. */
  .osp-back {
    position: fixed;
    z-index: 60;
    left: clamp(1.25rem, 4vw, 2.75rem);
    top: calc(clamp(1.25rem, 3.2vh, 1.9rem) - 12px);
  }

  .osp {
    position: relative;
    z-index: 1;
  }

  /* ── Stopka: kontener współdzielonego Footer.astro (szerokość jak na
     /realizacje/; sam footer jest bezmarginesowy — rodzic kontroluje layout) ── */
  .osp-foot {
    position: relative;
    z-index: 1;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 5vw 42px;
  }
</style>
