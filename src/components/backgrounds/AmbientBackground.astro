---
// Tło ambient w dwóch wariantach kolorystycznych (red/blue) — mechanika
// (gradienty, animacje, kropki, winieta) jest wspólna, różnią się wyłącznie
// kolory z ambient-palette.ts (jedyne źródło prawdy, także dla skryptu
// capture-ambient-bg.mjs generującego statyczne tekstury mobile).
import { AMBIENT_VARIANTS, type AmbientVariantName } from "./ambient-palette";

interface Props {
  variant: AmbientVariantName;
}
const { variant } = Astro.props;
const v = AMBIENT_VARIANTS[variant];

// Zmienne CSS na elemencie root: para oklch/rgb per kolor — o tym, która
// trafia do gradientów, decyduje @supports w arkuszu (zmienne-aliasy --c-*).
const vars: Record<string, string> = {
  ink: v.ink,
  mobileBg: `url("${v.mobileImage}")`,
};
for (const [key, color] of Object.entries(v.colors)) {
  vars[`${key}Ok`] = color.oklch;
  vars[`${key}Rgb`] = color.rgb;
}
---

<div class="ambient-bg" aria-hidden="true">
  <div class="ambient-bg__clouds">
    <span class="ambient-bg__cloud-c"></span>
    <span class="ambient-bg__cloud-d"></span>
  </div>
  <div class="ambient-bg__dots"></div>
</div>

<style define:vars={vars}>
  .ambient-bg {
    position: absolute;
    inset: 0;
    background: #000000;
    overflow: clip;
    isolation: isolate;
    /* Aliasy kolorów: domyślnie oklch; przeglądarki bez oklch dostają rgb
       w @supports niżej. Gradienty używają WYŁĄCZNIE --c-*. */
    --c-a1: var(--a1Ok);
    --c-a2: var(--a2Ok);
    --c-a3: var(--a3Ok);
    --c-b1: var(--b1Ok);
    --c-b2: var(--b2Ok);
    --c-b3: var(--b3Ok);
    --c-c1: var(--c1Ok);
    --c-d1: var(--d1Ok);
  }

  .ambient-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    box-shadow: inset 0 0 90px 14px var(--ink);
  }

  .ambient-bg__clouds {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  /* Chmury bez filter: blur (render-pass GPU co klatkę, ×4 warstwy) —
     miękkość dają same radial-gradienty. */
  .ambient-bg__clouds::before,
  .ambient-bg__clouds::after {
    content: "";
    position: absolute;
    width: 65%;
    height: 78%;
    will-change: transform;
  }
  .ambient-bg__clouds::before {
    bottom: -10%;
    left: -15%;
    background:
      radial-gradient(55% 65% at 35% 65%, var(--c-a1), transparent 72%),
      radial-gradient(50% 45% at 62% 40%, var(--c-a2), transparent 78%),
      radial-gradient(34% 42% at 18% 88%, var(--c-a3), transparent 68%);
    animation: drift-a 2s ease-in-out infinite alternate;
  }

  .ambient-bg__clouds::after {
    top: -25%;
    right: -25%;
    width: 80%;
    height: 94%;
    background:
      radial-gradient(62% 55% at 65% 38%, var(--c-b1), transparent 74%),
      radial-gradient(48% 50% at 38% 58%, var(--c-b2), transparent 80%),
      radial-gradient(30% 38% at 85% 18%, var(--c-b3), transparent 66%);
    animation: drift-b 2s ease-in-out infinite alternate;
  }

  .ambient-bg__cloud-c {
    position: absolute;
    top: 20%;
    right: -28%;
    width: 60%;
    height: 50%;
    will-change: transform;
    background: radial-gradient(closest-side, var(--c-c1), transparent 70%);
    animation: drift-c 3s ease-in-out infinite alternate;
  }

  .ambient-bg__cloud-d {
    position: absolute;
    top: -20%;
    left: 28%;
    width: 60%;
    height: 50%;
    will-change: transform;
    background: radial-gradient(closest-side, var(--c-d1), transparent 70%);
    animation: drift-c 4s ease-in-out infinite alternate;
  }

  @keyframes drift-a {
    from {
      transform: translate3d(2%, -2%, 0) rotate(-3deg) scale(1.06);
    }
    to {
      transform: translate3d(-9%, 8%, 0) rotate(6deg) scale(1.22);
    }
  }
  @keyframes drift-b {
    from {
      transform: translate3d(-2%, 2%, 0) rotate(4deg) scale(1.18);
    }
    to {
      transform: translate3d(9%, -8%, 0) rotate(-6deg) scale(1.02);
    }
  }
  @keyframes drift-c {
    from {
      transform: translate3d(0, 0, 0) scale(0.95);
    }
    to {
      transform: translate3d(5%, 6%, 0) scale(1.12);
    }
  }

  .ambient-bg__dots {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background-image: radial-gradient(
      circle,
      var(--ink) 0 1.1px,
      transparent 4px
    );
    background-size: 10px 9px;
    -webkit-mask-image: radial-gradient(
      ellipse 100% 95% at 50% 45%,
      #000 60%,
      transparent 100%
    );
    mask-image: radial-gradient(
      ellipse 100% 95% at 50% 45%,
      #000 60%,
      transparent 100%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient-bg__clouds::before,
    .ambient-bg__clouds::after,
    .ambient-bg__cloud-c,
    .ambient-bg__cloud-d {
      animation: none;
    }
  }

  /* Mobile: zamiast czterech animowanych, kompozytowanych warstw gradientowych
     + maski kropek — jedna płaska, statyczna tekstura (per wariant). Zero
     animacji: minimalne GPU/CPU. Wygląd identyczny (grafika = render tych
     warstw). Regeneracja: node scripts/capture-ambient-bg.mjs */
  @media (max-width: 768px) {
    .ambient-bg {
      background:
        center / cover no-repeat var(--mobileBg),
        #000000;
    }
    .ambient-bg::after,
    .ambient-bg__clouds,
    .ambient-bg__dots {
      display: none;
    }
    /* Warstwa nieaktywna nie pobiera tekstury (od rozdziału red/blue to
       osobne pliki — eager fetch obu psuł budżet LCP mobile). Obraz dociąga
       się, gdy pre-warm crossfade'u zdejmie is-inactive ~1 viewport przed
       fade-in; do tego czasu warstwa i tak ma opacity 0, a przenikanie
       idzie przez czerń. */
    :global(.bg-layer.is-inactive) .ambient-bg {
      background-image: none;
    }
  }

  :global(.bg-layer.is-inactive) .ambient-bg__clouds::before,
  :global(.bg-layer.is-inactive) .ambient-bg__clouds::after,
  :global(.bg-layer.is-inactive) .ambient-bg__cloud-c,
  :global(.bg-layer.is-inactive) .ambient-bg__cloud-d {
    animation-play-state: paused;
    /* Nieaktywna warstwa (opacity 0) nie potrzebuje promocji GPU chmur —
       bez tego desktop trzyma do ~28 warstw kompozycji (7 teł × 4 chmury);
       Home.astro zdejmuje will-change tylko z samej .bg-layer. */
    will-change: auto;
  }

  /* Fallback bez oklch: te same gradienty, kolory rgb z palety (przeliczone
     z oklch przez Chromium). Uwaga: kolory MUSZĄ iść przez aliasy --c-*,
     bo var() z niewspieranym oklch nie cofa się do wcześniejszej deklaracji
     background (IACVT) — podmieniamy więc źródło aliasu, nie deklaracje. */
  @supports not (color: oklch(0 0 0)) {
    .ambient-bg {
      --c-a1: var(--a1Rgb);
      --c-a2: var(--a2Rgb);
      --c-a3: var(--a3Rgb);
      --c-b1: var(--b1Rgb);
      --c-b2: var(--b2Rgb);
      --c-b3: var(--b3Rgb);
      --c-c1: var(--c1Rgb);
      --c-d1: var(--d1Rgb);
    }
  }
</style>
