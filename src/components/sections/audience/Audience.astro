---
// Sekcja „Dla kogo" — design „Talia kart" (port referencji
// docs/design/dla-kogo-referencja/; decyzje: docs/analiza-sekcja-dla-kogo.md).
// Markup + style tutaj; animacje scrolla w audience-scroll.ts (ładowane tylko
// przy prefers-reduced-motion: no-preference). Bez JS / przy reduce sekcja
// renderuje statyczny układ flow ze stanami docelowymi (okna ostre, mocki
// desktopowe ukryte).
//
// Dwa warianty (docs/analiza-podstrona-dla-kogo.md): "full" = pełna
// animowana sekcja (podstrona /dla-kogo/); "teaser" = statyczna pierwsza
// klatka sceny na stronie głównej (rozdział 00 + wachlarz okien + przycisk
// SolidButton na podstronę) — bez stosu, licznika, cyfr i modułu scrolla.
import { navItems, navLabel } from "@/i18n/nav";
import { useTranslations, type Lang } from "@/i18n/utils";
import { AUDIENCE_PATH, SERVICES_PATH } from "@/lib/routes";
import SolidButton from "@/components/ui/SolidButton.astro";
import AudienceMockWindow from "./AudienceMockWindow.astro";
import ekranHome from "@/assets/audience/ekran-home.webp";
import ekranCms from "@/assets/audience/ekran-cms.webp";
import ekranReservation from "@/assets/audience/ekran-reservation.webp";

interface Props {
  lang: Lang;
  variant?: "teaser" | "full";
}
const { lang, variant = "full" } = Astro.props;
const teaser = variant === "teaser";
const t = useTranslations(lang);
const item = navItems.find((n) => n.id === "audience");
const label = item ? navLabel(item, lang) : "Dla kogo";

const chapters = [
  {
    tag: t("audience.ch0.tag"),
    lead: t("audience.ch0.headLead"),
    accent: t("audience.ch0.headAccent"),
    para: t("audience.ch0.para"),
  },
  {
    tag: t("audience.ch1.tag"),
    lead: t("audience.ch1.headLead"),
    accent: t("audience.ch1.headAccent"),
    para: t("audience.ch1.para"),
  },
  {
    tag: t("audience.ch2.tag"),
    lead: t("audience.ch2.headLead"),
    accent: t("audience.ch2.headAccent"),
    para: t("audience.ch2.para"),
  },
  {
    tag: t("audience.ch3.tag"),
    lead: t("audience.ch3.headLead"),
    accent: t("audience.ch3.headAccent"),
    para: t("audience.ch3.para"),
  },
];

// Ekrany-dowody (te same na desktop i mobile): wypieczone screeny LUMÉA
// w jasnym oknie z chrome'em. Rozdziały 01–03 ↔ home / cms / reservation.
// Dekoracyjne (aria-hidden na rodzicu), więc alt="".
const screens = [
  { src: ekranHome, url: "lumea.pl" },
  { src: ekranCms, url: "lumea.pl/edytuj-strone" },
  { src: ekranReservation, url: "lumea.pl/rezerwuj-wizyte" },
] as const;

const caps = [t("audience.cap1"), t("audience.cap2"), t("audience.cap3")];
---

<section
  id="audience"
  class:list={["dk", { "dk--teaser": teaser }]}
  data-variant={variant}
  aria-label={label}
>
  <script is:inline>
    // Bez JS sekcja zostaje w statycznym układzie flow (fallback); klasa .js
    // włącza desktopową scenę przypiętą (patrz @media niżej) — tylko
    // w pełnym wariancie (zajawka jest statyczna z definicji).
    {
      const s = document.currentScript?.closest("section");
      if (s?.dataset.variant === "full") s.classList.add("js");
    }
  </script>
  <div class="dk-stage">
    <!-- widmowa typografia: napis intro + cyfry 1/2/3 (desktop) -->
    <div class="dk-ghostintro" aria-hidden="true">{t("audience.ghost")}</div>
    {
      !teaser && (
        <div class="dk-digitwrap" aria-hidden="true">
          <div class="dk-digit" data-d="0">
            1
          </div>
          <div class="dk-digit" data-d="1">
            2
          </div>
          <div class="dk-digit" data-d="2">
            3
          </div>
        </div>
      )
    }

    <!-- podgląd intro (desktop): docelowy wachlarz trzech okien — tak jak
         prawa strona wygląda przy odczepieniu sekcji. Znika na starcie scrolla,
         po czym rusza budowa karta-po-karcie. Kolejność = z-order (ostatni na
         wierzchu: reservation ≙ karta 3 finału). -->
    <div class="dk-backs" aria-hidden="true">
      {
        screens.map((s, i) => (
          <div class={`dk-back bk-${i}`}>
            <AudienceMockWindow screen={s.src} url={s.url} />
          </div>
        ))
      }
    </div>

    <!-- stos kart-dowodów (desktop); podpis DOWÓD x/03 podmienia onChange
         progresu w audience-scroll.ts -->
    {
      !teaser && (
        <div class="dk-stack" aria-hidden="true">
          {screens.map((s) => (
            <div class="dk-card">
              <AudienceMockWindow screen={s.src} url={s.url} />
            </div>
          ))}
          <div
            class="dk-cap"
            data-cap1={caps[0]}
            data-cap2={caps[1]}
            data-cap3={caps[2]}
          >
            <span class="capline" />
            <span class="captext">{caps[0]}</span>
          </div>
        </div>
      )
    }

    <!-- chrome sekcji -->
    <div class="dk-tag">
      <span class="t-num">01</span><span class="t-sl" aria-hidden="true">/</span
      ><span class="t-lbl">{label}</span>
    </div>
    <div class="dk-meta" aria-hidden="true">{t("audience.meta")}</div>

    <!-- rozdziały 00–03 (desktop: wymieniają się na przypiętej scenie;
         mobile: flow, rozdziały 01–03 z oknem-obrazkiem); zajawka renderuje
         WYŁĄCZNIE rozdział 00 + przycisk na podstronę -->
    <div class="dk-chapters">
      {
        (teaser ? chapters.slice(0, 1) : chapters).map((ch, i) => (
          <article class="dk-ch" data-ch={i}>
            {i > 0 && (
              <>
                <div class="dkm-win" aria-hidden="true">
                  <AudienceMockWindow
                    screen={screens[i - 1].src}
                    url={screens[i - 1].url}
                  />
                </div>
                <div class="dkm-digit" aria-hidden="true">
                  {i}
                </div>
              </>
            )}
            <div class="ch-tag">{ch.tag}</div>
            {i === 0 ? (
              <h2 class="ch-head">
                {ch.lead} <em class="sf">{ch.accent}</em>
              </h2>
            ) : (
              <h3 class="ch-head">
                {ch.lead} <em class="sf">{ch.accent}</em>
              </h3>
            )}
            <p class="ch-para">{ch.para}</p>
            {teaser && i === 0 && (
              <div class="dk-morewrap">
                {/* wrapper, nie klasa na komponencie — scoped CSS nie łapie
                    elementów renderowanych przez komponent potomny */}
                <SolidButton
                  href={AUDIENCE_PATH[lang]}
                  label={t("audience.more")}
                />
              </div>
            )}
            {i === 3 && (
              // CTA rozdziału 03 „Poznaj ofertę" → hub /oferta/ (migracja
              // Oferty: docs/analiza-podstrona-oferta-hub.md; wcześniej
              // tymczasowo /kontakt/).
              <a class="dk-cta" href={SERVICES_PATH[lang]}>
                {t("audience.cta")}
                <span class="arr" aria-hidden="true">
                  →
                </span>
              </a>
            )}
          </article>
        ))
      }
    </div>

    <!-- progres 01/04 (tylko desktop, czysto wizualny) -->
    {
      !teaser && (
        <div class="dk-progress" aria-hidden="true">
          <div class="ticks">
            <i class="on" />
            <i />
            <i />
            <i />
          </div>
          <span class="pcount">01 / 04</span>
        </div>
      )
    }
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>("#audience");

  // Animacje tylko w pełnym wariancie (podstrona) i przy dozwolonym ruchu —
  // ta sama bramka co Lenis w BaseLayout; przy reduce statyczny układ
  // realizuje czysty CSS. Zajawka (teaser) nie pobiera chunka GSAP w ogóle.
  if (
    section?.dataset.variant === "full" &&
    matchMedia("(prefers-reduced-motion: no-preference)").matches
  ) {
    import("./audience-scroll").then((m) => m.initAudienceScroll());
  }
</script>

<style>
  /* ═══ Sekcja „Dla kogo" — wartości „zamrożone" z prototypu referencji:
     --dklen 700vh · scrub 0.6 · snap [0.04,0.30,0.58,0.94] · fan 1.4 ·
     --rk 0.12 · --rkp 0.9px (pow(0.12, 2.2) × 99px) · --mkch 32px.
     Paleta/fonty z tokenów projektu (global.css); tło sekcji lokalne.
     UWAGA: breakpointy @media (861px) MUSZĄ być równe AUDIENCE_DESKTOP_MIN_PX
     (audience-config.ts) — @media nie umie czytać var(), stąd literały. ═══ */
  .dk {
    --dklen: 700vh; /* długość jazdy przypiętej sceny (desktop) */
    --dkcw: min(36.5vw, 700px); /* szerokość karty na stosie */
    --rk: 0.12; /* zaokrąglenia okien/UI: 0 = ostre, 1 = pełne */
    --rkp: 0.9px; /* promień „pilli" (wyliczone: pow(--rk, 2.2) × 99px) */
    --mkch: 32px; /* wysokość paska okna przeglądarki (chrome) */
    position: relative;
    color: var(--ink);
    font-family: var(--font-body), sans-serif;
  }
  /* Tło sekcji: przezroczyste — widać globalny ambient (bg-stage, wariant
     blue) sterowany crossfadem. Lokalna atmosfera (mgła/winieta/mesh) usunięta. */
  .dk-stage {
    position: relative;
    overflow: hidden;
  }

  /* ── widmowa typografia: napis intro + cyfry 1/2/3 ── */
  .dk-ghostintro,
  .dk-digit {
    position: absolute;
    pointer-events: none;
    user-select: none;
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    line-height: 0.82;
    letter-spacing: -0.045em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(245, 240, 236, 0.09);
  }
  .dk-digit {
    -webkit-text-stroke: 2px rgba(245, 240, 236, 0.1);
  }

  /* ── chrome sekcji: tag, meta, progres ── */
  .dk-tag {
    z-index: 9;
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-family: var(--font-mono), monospace;
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }
  .dk-tag .t-num {
    color: var(--accent);
  }
  .dk-tag .t-sl {
    color: var(--faint);
  }
  .dk-tag .t-lbl {
    color: var(--muted);
  }
  .dk-meta {
    position: absolute;
    z-index: 9;
    font-family: var(--font-mono), monospace;
    font-size: 11px;
    letter-spacing: 0.26em;
    color: var(--faint);
    text-transform: uppercase;
  }
  .dk-progress {
    position: absolute;
    z-index: 9;
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .dk-progress .ticks {
    display: flex;
    gap: 7px;
  }
  .dk-progress .ticks i {
    width: 26px;
    height: 2px;
    background: var(--line);
    transition: background 0.3s;
  }
  .dk-progress .ticks i.on {
    background: var(--accent);
  }
  .dk-progress .pcount {
    font-family: var(--font-mono), monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  /* ── typografia rozdziałów ── */
  .ch-tag {
    font-family: var(--font-mono), monospace;
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--accent);
    text-transform: uppercase;
  }
  .ch-head {
    margin: 0;
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--ink);
    text-wrap: balance;
  }
  .ch-head .sf {
    font-family: var(--font-serif), serif;
    font-style: italic;
    font-weight: 400;
    font-size: 1.06em;
    letter-spacing: 0;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .ch-para {
    margin: 0;
    font-weight: 400;
    line-height: 1.62;
    /* Jaśniej niż --muted (0.58), ale nie pełny biały nagłówka (--ink) —
       lepsza czytelność akapitów rozdziałów na tle ambientu. */
    color: rgba(245, 240, 236, 0.72);
  }
  .dk-cta {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    align-self: flex-start;
    border-bottom: 1px solid var(--line);
    padding-bottom: 12px;
    margin-top: 6px;
    font-weight: 600;
    font-size: 20px;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }
  .dk-cta:hover {
    color: var(--ink);
  }
  .dk-cta .arr {
    color: var(--accent);
    transition: transform 0.25s;
  }
  .dk-cta:hover .arr {
    transform: translateX(6px);
  }
  /* przycisk zajawki (SolidButton) — wrapper w flow rozdziału 00 */
  .dk-morewrap {
    margin-top: 6px;
  }

  /* Zajawka mobile: cały blok podciągnięty do góry — bazowe wartości
     (padding-top 84px, ghost 92px, margin rozdziału 118px) celowały w pełny
     układ flow. Tag „01 / DLA KOGO" siedzi tuż przy górnej krawędzi sekcji,
     więc pokazuje się od razu po odpięciu hero (sticky: sekcja wchodzi
     w viewport dopiero po odpięciu — bez ryzyka prześwitu w trakcie hero);
     relacja tag→ghost zachowana (delta -76px na obu). Dokładne dopełnienie
     desktopowego progu (nie max-width — bez dziury na ułamkowych
     szerokościach); 861px = AUDIENCE_DESKTOP_MIN_PX. */
  @media not all and (min-width: 861px) {
    .dk--teaser .dk-stage {
      padding-top: 8px;
      /* Zajawka wypełnia dokładnie viewport: „02 / OFERTA" zaczyna wjeżdżać
         dopiero, gdy tag „01 / DLA KOGO" wyjeżdża górą. 100vh na mobile =
         duży viewport (pasek URL schowany — naturalny stan przy scrollu
         w dół); przy widocznym pasku sekcja jest o jego wysokość „za długa"
         (Oferta wjedzie chwilę później — celowo ta strona kompromisu,
         nigdy za wcześnie). Nadmiar wysokości zostaje pustką pod przyciskiem
         (flex column, treść kotwiczona u góry — odstępy bez zmian). */
      min-height: 100vh;
    }
    .dk--teaser .dk-ghostintro {
      top: 16px;
    }
    .dk--teaser .dk-ch[data-ch="0"] {
      margin-top: 52px;
    }
  }

  /* ── karty desktop (rewersy + stos): niewidoczne poza sceną ── */
  .dk-backs,
  .dk-stack,
  .dk-cap,
  .dk-meta,
  .dk-progress,
  .dk-digitwrap {
    display: none;
  }
  /* Podgląd intro = docelowy wachlarz. Każdy .dk-back to kontener na okno
     (AudienceMockWindow), ustawiony w pozycji finału z audience-scroll.ts
     (xPercent·F / yPercent·F / rotation·F, F=1.4). Dwie tylne karty przygaszone
     jak cofnięte (opacity + lekki blur), wierzch pełny — 1:1 ze stanem, w jakim
     prawa strona jest przy odczepieniu sekcji. */
  .dk-back {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    transform-origin: 50% 50%;
  }
  .dk-back.bk-0 {
    transform: translate(-25.6%, 14.3%) rotate(-12.6deg);
    opacity: 0.5;
    filter: blur(1.5px);
  }
  .dk-back.bk-1 {
    transform: translate(20.9%, 9%) rotate(9.1deg);
    opacity: 0.55;
    filter: blur(1.5px);
  }
  .dk-back.bk-2 {
    transform: translate(0, -1.6%) rotate(-1.5deg);
  }
  .dk-cap .capline {
    width: 22px;
    height: 1px;
    background: rgba(245, 240, 236, 0.3);
  }
  .dk-cap .captext {
    font-family: var(--font-mono), monospace;
    font-size: 9px;
    letter-spacing: 0.24em;
    color: var(--faint);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ═══ UKŁAD BAZOWY: mobile / flow / no-JS / reduced-motion ═══
     Kolejność w flow (order): tag → 00 → 01 → 02 → 03 */
  .dk-stage {
    display: flex;
    flex-direction: column;
    padding: 84px 26px 72px;
    gap: 42px;
  }
  .dk-ghostintro {
    font-size: 118px;
    left: 14px;
    top: 92px;
    z-index: 4;
  }
  .dk-tag {
    order: 1;
  }
  .dk-chapters {
    display: contents;
  }
  .dk-ch {
    position: relative;
    z-index: 7;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .dk-ch .ch-head {
    font-size: 40px;
  }
  .dk-ch .ch-para {
    font-size: 15px;
    line-height: 1.6;
    max-width: 560px;
  }
  .dk-ch[data-ch="0"] {
    order: 2;
    margin-top: 118px;
  }
  .dk-ch[data-ch="0"] .ch-head {
    font-size: 46px;
  }
  .dk-ch[data-ch="1"] {
    order: 3;
    border-top: 1px solid var(--line);
    padding-top: 34px;
  }
  .dk-ch[data-ch="2"] {
    order: 4;
    border-top: 1px solid var(--line);
    padding-top: 34px;
  }
  .dk-ch[data-ch="3"] {
    order: 5;
    border-top: 1px solid var(--line);
    padding-top: 34px;
  }

  /* mobile: okno = JEDEN wypieczony ekran w jasnym oknie (AudienceMockWindow).
     Blur USUNIĘTY — animacja wjazdu (x z lewej/prawej) liczona w scrollu;
     zero filter w runtime. Rotację nadaje GSAP (stała w tweenie), żeby nie
     kolidowała z transformem wjazdu; no-JS/reduce = okno proste (bez rotacji). */
  .dkm-win {
    position: relative;
    z-index: 1;
    margin: 6px 0 4px;
  }
  .dkm-digit {
    position: absolute;
    right: -8px;
    top: -46px;
    z-index: 0;
    pointer-events: none;
    user-select: none;
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    font-size: 150px;
    line-height: 0.82;
    letter-spacing: -0.045em;
    color: transparent;
    -webkit-text-stroke: 2px rgba(245, 240, 236, 0.1);
  }

  /* Szeroki układ flow (no-JS albo reduced-motion na desktopie):
     wygodniejszy padding boczny jak w About; pełna atmosfera wraca
     na desktopowym GPU. 861px = AUDIENCE_DESKTOP_MIN_PX. */
  @media (min-width: 861px) {
    .dk-stage {
      padding: 96px clamp(26px, 7vw, 120px) 84px;
    }
  }

  /* ═══ UKŁAD DESKTOP: przypięta scena (sticky) + stany scrolla ═══
     Wyłącznie przy dozwolonym ruchu i działającym JS (klasa .js) —
     861px = AUDIENCE_DESKTOP_MIN_PX (kontrakt z audience-config.ts). */
  @media (min-width: 861px) and (prefers-reduced-motion: no-preference) {
    .dk.js {
      height: var(--dklen);
    }
    .dk.js .dk-stage {
      position: sticky;
      top: 0;
      height: 100vh;
      display: block;
      padding: 0;
    }

    .dk.js .dk-ghostintro {
      font-size: min(13vw, 250px);
      left: 7.3vw;
      top: auto;
      bottom: 13vh;
    }
    .dk.js .dk-digitwrap {
      display: block;
    }
    .dk.js .dk-digit {
      left: 64vw;
      top: 8vh;
      font-size: min(41vw, 790px);
      z-index: 4;
      opacity: 0;
    }

    .dk.js .dk-tag {
      position: absolute;
      top: 8.8vh;
      left: 7.8vw;
    }
    .dk.js .dk-meta {
      display: flex;
      top: 8.8vh;
      right: 7.8vw;
    }
    .dk.js .dk-progress {
      display: flex;
      bottom: 7.6vh;
      left: 7.8vw;
    }

    .dk.js .dk-chapters {
      display: block;
      position: absolute;
      z-index: 7;
      left: 7.8vw;
      top: 50%;
      width: min(35vw, 680px);
      height: 0;
    }
    .dk.js .dk-ch {
      position: absolute;
      left: 0;
      top: 0;
      margin: 0;
      padding: 0;
      border: 0;
      gap: 26px;
    }
    .dk.js .dk-ch .ch-head {
      font-size: min(4.2vw, 80px);
    }
    .dk.js .dk-ch[data-ch="0"] .ch-head {
      font-size: min(5vw, 96px);
    }
    .dk.js .dk-ch .ch-para {
      font-size: clamp(15px, 0.94vw, 18px);
      max-width: 620px;
    }
    .dk.js .dkm-win,
    .dk.js .dkm-digit {
      display: none;
    }

    .dk.js .dk-backs {
      display: block;
      position: absolute;
      left: 58.5vw;
      top: 27vh;
      width: var(--dkcw);
      z-index: 4;
    }
    .dk.js .dk-stack {
      display: block;
      position: absolute;
      left: 58.5vw;
      top: 27vh;
      width: var(--dkcw);
      height: calc(var(--mkch, 46px) + var(--dkcw) * 0.6523);
      z-index: 5;
    }
    .dk.js .dk-card {
      position: absolute;
      left: 0;
      top: 0;
