---
// Sekcja „Dla kogo" — design „Talia kart" (port referencji
// docs/design/dla-kogo-referencja/; decyzje: docs/analiza-sekcja-dla-kogo.md).
// Markup + style tutaj; animacje scrolla w audience-scroll.ts (ładowane tylko
// przy prefers-reduced-motion: no-preference). Bez JS / przy reduce sekcja
// renderuje statyczny układ flow ze stanami docelowymi (okna ostre, mocki
// desktopowe ukryte).
import { Image } from "astro:assets";
import { navItems, navLabel } from "@/i18n/nav";
import { useTranslations, type Lang } from "@/i18n/utils";
import AudienceMockWindow from "./AudienceMockWindow.astro";
import ekranWow from "@/assets/audience/ekran-wow.webp";
import ekranWowBlur from "@/assets/audience/ekran-wow-blur.webp";
import ekranCms from "@/assets/audience/ekran-cms.webp";
import ekranCmsBlur from "@/assets/audience/ekran-cms-blur.webp";
import ekranTools from "@/assets/audience/ekran-tools.webp";
import ekranToolsBlur from "@/assets/audience/ekran-tools-blur.webp";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const item = navItems.find((n) => n.id === "audience");
const label = item ? navLabel(item, lang) : "Dla kogo";

const chapters = [
  {
    tag: t("audience.ch0.tag"),
    lead: t("audience.ch0.headLead"),
    accent: t("audience.ch0.headAccent"),
    para: t("audience.ch0.para"),
  },
  {
    tag: t("audience.ch1.tag"),
    lead: t("audience.ch1.headLead"),
    accent: t("audience.ch1.headAccent"),
    para: t("audience.ch1.para"),
  },
  {
    tag: t("audience.ch2.tag"),
    lead: t("audience.ch2.headLead"),
    accent: t("audience.ch2.headAccent"),
    para: t("audience.ch2.para"),
  },
  {
    tag: t("audience.ch3.tag"),
    lead: t("audience.ch3.headLead"),
    accent: t("audience.ch3.headAccent"),
    para: t("audience.ch3.para"),
  },
];

// Okna mobilne rozdziałów 01–03: DWA wypieczone obrazki (ostry + blur w pliku)
// — „wyostrzenie z mgły" to crossfade wyłącznie na opacity (zero filter
// w runtime). Dekoracyjne (aria-hidden), więc alt="".
const wins = [
  { sharp: ekranWow, blur: ekranWowBlur },
  { sharp: ekranCms, blur: ekranCmsBlur },
  { sharp: ekranTools, blur: ekranToolsBlur },
];

// Karty-dowody sceny desktop. Etykiety-pille są częścią mocka — celowo PL
// w obu wersjach językowych (decyzja portu §II.3).
const cardMocks = [
  { kind: "wow", label: "PIERWSZE WRAŻENIE" },
  { kind: "cms", label: "TWÓJ PANEL CMS" },
  { kind: "tools", label: "MODUŁY ZAROBKOWE" },
] as const;

const caps = [t("audience.cap1"), t("audience.cap2"), t("audience.cap3")];
---

<section id="audience" class="dk" aria-label={label}>
  <script is:inline>
    // Bez JS sekcja zostaje w statycznym układzie flow (fallback);
    // klasa .js włącza desktopową scenę przypiętą (patrz @media niżej).
    document.currentScript?.closest("section")?.classList.add("js");
  </script>
  <div class="dk-stage">
    <!-- widmowa typografia: napis intro + cyfry 1/2/3 (desktop) -->
    <div class="dk-ghostintro" aria-hidden="true">{t("audience.ghost")}</div>
    <div class="dk-digitwrap" aria-hidden="true">
      <div class="dk-digit" data-d="0">1</div>
      <div class="dk-digit" data-d="1">2</div>
      <div class="dk-digit" data-d="2">3</div>
    </div>

    <!-- talia rewersów we mgle (stan intro, desktop) -->
    <div class="dk-backs" aria-hidden="true">
      <div class="dk-back b3"><span>03</span></div>
      <div class="dk-back b2"><span>02</span></div>
      <div class="dk-back b1"><span>01</span></div>
    </div>

    <!-- stos kart-dowodów (desktop); podpis DOWÓD x/03 podmienia setStage() -->
    <div class="dk-stack" aria-hidden="true">
      {
        cardMocks.map((m) => (
          <div class="dk-card">
            <AudienceMockWindow kind={m.kind} label={m.label} />
          </div>
        ))
      }
      <div
        class="dk-cap"
        data-cap1={caps[0]}
        data-cap2={caps[1]}
        data-cap3={caps[2]}
      >
        <span class="capline"></span><span class="captext">{caps[0]}</span>
      </div>
    </div>

    <!-- chrome sekcji -->
    <div class="dk-tag">
      <span class="t-num">01</span><span class="t-sl" aria-hidden="true">/</span
      ><span class="t-lbl">{label}</span>
    </div>
    <div class="dk-meta" aria-hidden="true">{t("audience.meta")}</div>

    <!-- rozdziały 00–03 (desktop: wymieniają się na przypiętej scenie;
         mobile: flow, rozdziały 01–03 z oknem-obrazkiem) -->
    <div class="dk-chapters">
      {
        chapters.map((ch, i) => (
          <article class="dk-ch" data-ch={i}>
            {i > 0 && (
              <>
                <div class="dkm-win" aria-hidden="true">
                  <Image
                    class="lay-sharp"
                    src={wins[i - 1].sharp}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                  <Image
                    class="lay-blur"
                    src={wins[i - 1].blur}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="dkm-digit" aria-hidden="true">
                  {i}
                </div>
              </>
            )}
            <div class="ch-tag">{ch.tag}</div>
            {i === 0 ? (
              <h2 class="ch-head">
                {ch.lead} <em class="sf">{ch.accent}</em>
              </h2>
            ) : (
              <h3 class="ch-head">
                {ch.lead} <em class="sf">{ch.accent}</em>
              </h3>
            )}
            <p class="ch-para">{ch.para}</p>
            {i === 3 && (
              <a class="dk-cta" href="#services">
                {t("audience.cta")}
                <span class="arr" aria-hidden="true">
                  →
                </span>
              </a>
            )}
          </article>
        ))
      }
    </div>

    <!-- progres 01/04 (tylko desktop, czysto wizualny) -->
    <div class="dk-progress" aria-hidden="true">
      <div class="ticks"><i class="on"></i><i></i><i></i><i></i></div>
      <span class="pcount">01 / 04</span>
    </div>
  </div>
</section>

<script>
  // Animacje tylko przy dozwolonym ruchu — ta sama bramka co Lenis
  // w BaseLayout; przy reduce statyczny układ realizuje czysty CSS.
  if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    import("./audience-scroll").then((m) => m.initAudienceScroll());
  }

  // CTA: skok jak w navbarze (Lenis immediate + podmiana hash),
  // fallback natywny gdy Lenisa nie ma.
  const cta = document.querySelector<HTMLAnchorElement>("#audience .dk-cta");
  cta?.addEventListener("click", (e) => {
    const target = document.getElementById("services");
    if (!target) return;
    e.preventDefault();
    if (window.__lenis) {
      window.__lenis.scrollTo(target, { offset: 0, immediate: true });
    } else {
      target.scrollIntoView({ behavior: "auto", block: "start" });
    }
    history.replaceState(null, "", "#services");
  });
</script>

<style>
  /* ═══ Sekcja „Dla kogo" — wartości „zamrożone" z prototypu referencji:
     --dklen 700vh · scrub 0.6 · snap [0.04,0.30,0.58,0.94] · fan 1.4 ·
     --rk 0.12 · --rkp 0.9px (pow(0.12, 2.2) × 99px) · --mkch 32px.
     Paleta/fonty z tokenów projektu (global.css); tło sekcji lokalne.
     UWAGA: breakpointy @media (861px) MUSZĄ być równe AUDIENCE_DESKTOP_MIN_PX
     (audience-config.ts) — @media nie umie czytać var(), stąd literały. ═══ */
  .dk {
    --dklen: 700vh; /* długość jazdy przypiętej sceny (desktop) */
    --dkcw: min(36.5vw, 700px); /* szerokość karty na stosie */
    --rk: 0.12; /* zaokrąglenia okien/UI: 0 = ostre, 1 = pełne */
    --rkp: 0.9px; /* promień „pilli" (wyliczone: pow(--rk, 2.2) × 99px) */
    --mkch: 32px; /* wysokość paska okna przeglądarki (chrome) */
    position: relative;
    color: var(--ink);
    font-family: var(--font-body), sans-serif;
  }
  /* Tło sekcji: przezroczyste — widać globalny ambient (bg-stage, wariant
     blue) sterowany crossfadem. Lokalna atmosfera (mgła/winieta/mesh) usunięta. */
  .dk-stage {
    position: relative;
    overflow: hidden;
  }

  /* ── widmowa typografia: napis intro + cyfry 1/2/3 ── */
  .dk-ghostintro,
  .dk-digit {
    position: absolute;
    pointer-events: none;
    user-select: none;
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    line-height: 0.82;
    letter-spacing: -0.045em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(245, 240, 236, 0.09);
  }
  .dk-digit {
    -webkit-text-stroke: 2px rgba(245, 240, 236, 0.1);
  }

  /* ── chrome sekcji: tag, meta, progres ── */
  .dk-tag {
    z-index: 9;
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-family: var(--font-mono), monospace;
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }
  .dk-tag .t-num {
    color: var(--accent);
  }
  .dk-tag .t-sl {
    color: var(--faint);
  }
  .dk-tag .t-lbl {
    color: var(--muted);
  }
  .dk-meta {
    position: absolute;
    z-index: 9;
    font-family: var(--font-mono), monospace;
    font-size: 11px;
    letter-spacing: 0.26em;
    color: var(--faint);
    text-transform: uppercase;
  }
  .dk-progress {
    position: absolute;
    z-index: 9;
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .dk-progress .ticks {
    display: flex;
    gap: 7px;
  }
  .dk-progress .ticks i {
    width: 26px;
    height: 2px;
    background: var(--line);
    transition: background 0.3s;
  }
  .dk-progress .ticks i.on {
    background: var(--accent);
  }
  .dk-progress .pcount {
    font-family: var(--font-mono), monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  /* ── typografia rozdziałów ── */
  .ch-tag {
    font-family: var(--font-mono), monospace;
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--accent);
    text-transform: uppercase;
  }
  .ch-head {
    margin: 0;
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--ink);
    text-wrap: balance;
  }
  .ch-head .sf {
    font-family: var(--font-serif), serif;
    font-style: italic;
    font-weight: 400;
    font-size: 1.06em;
    letter-spacing: 0;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .ch-para {
    margin: 0;
    font-weight: 400;
    line-height: 1.62;
    /* Jaśniej niż --muted (0.58), ale nie pełny biały nagłówka (--ink) —
       lepsza czytelność akapitów rozdziałów na tle ambientu. */
    color: rgba(245, 240, 236, 0.72);
  }
  .dk-cta {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    align-self: flex-start;
    border-bottom: 1px solid var(--line);
    padding-bottom: 12px;
    margin-top: 6px;
    font-weight: 600;
    font-size: 20px;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }
  .dk-cta:hover {
    color: var(--ink);
  }
  .dk-cta .arr {
    color: var(--accent);
    transition: transform 0.25s;
  }
  .dk-cta:hover .arr {
    transform: translateX(6px);
  }

  /* ── karty desktop (rewersy + stos): niewidoczne poza sceną ── */
  .dk-backs,
  .dk-stack,
  .dk-cap,
  .dk-meta,
  .dk-progress,
  .dk-digitwrap {
    display: none;
  }
  .dk-back {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    aspect-ratio: 880/620;
    border-radius: calc(16px * var(--rk, 1));
    background: #161016;
    box-shadow:
      inset 0 0 0 1.5px rgba(245, 240, 236, 0.2),
      0 30px 80px rgba(0, 0, 0, 0.5);
  }
  .dk-back::before {
    content: "";
    position: absolute;
    inset: 14px;
    border-radius: calc(10px * var(--rk, 1));
    border: 1px dashed rgba(245, 240, 236, 0.16);
  }
  .dk-back span {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-mono), monospace;
    font-size: 12px;
    letter-spacing: 0.34em;
    color: rgba(245, 240, 236, 0.42);
  }
  .dk-back.b2 {
    transform: translate(-40px, 30px) rotate(-5deg);
  }
  .dk-back.b3 {
    transform: translate(56px, 62px) rotate(6deg);
  }
  .dk-back.b1 {
    transform: rotate(1deg);
  }
  .dk-cap .capline {
    width: 22px;
    height: 1px;
    background: rgba(245, 240, 236, 0.3);
  }
  .dk-cap .captext {
    font-family: var(--font-mono), monospace;
    font-size: 9px;
    letter-spacing: 0.24em;
    color: var(--faint);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ═══ UKŁAD BAZOWY: mobile / flow / no-JS / reduced-motion ═══
     Kolejność w flow (order): tag → 00 → 01 → 02 → 03 */
  .dk-stage {
    display: flex;
    flex-direction: column;
    padding: 84px 26px 72px;
    gap: 42px;
  }
  .dk-ghostintro {
    font-size: 118px;
    left: 14px;
    top: 92px;
    z-index: 4;
  }
  .dk-tag {
    order: 1;
  }
  .dk-chapters {
    display: contents;
  }
  .dk-ch {
    position: relative;
    z-index: 7;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .dk-ch .ch-head {
    font-size: 40px;
  }
  .dk-ch .ch-para {
    font-size: 15px;
    line-height: 1.6;
    max-width: 560px;
  }
  .dk-ch[data-ch="0"] {
    order: 2;
    margin-top: 118px;
  }
  .dk-ch[data-ch="0"] .ch-head {
    font-size: 46px;
  }
  .dk-ch[data-ch="1"] {
    order: 3;
    border-top: 1px solid var(--line);
    padding-top: 34px;
  }
  .dk-ch[data-ch="2"] {
    order: 4;
    border-top: 1px solid var(--line);
    padding-top: 34px;
  }
  .dk-ch[data-ch="3"] {
    order: 5;
    border-top: 1px solid var(--line);
    padding-top: 34px;
  }

  /* mobile: okno = 2 GOTOWE obrazki (ostry + rozmycie wypieczone w pliku)
     — crossfade WYŁĄCZNIE opacity; przeglądarka nie liczy żadnego blura.
     Warstwa blur domyślnie niewidoczna → no-JS i reduce pokazują ostre okno. */
  .dkm-win {
    position: relative;
    z-index: 1;
    margin: 6px 0 4px;
  }
  .dk-ch[data-ch="1"] .dkm-win,
  .dk-ch[data-ch="3"] .dkm-win {
    transform: rotate(-1.5deg);
  }
  .dk-ch[data-ch="2"] .dkm-win {
    transform: rotate(1.5deg);
  }
  .dkm-win img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(16px * var(--rk, 1));
    user-select: none;
    pointer-events: none;
  }
  .dkm-win :global(.lay-sharp) {
    position: relative;
    box-shadow:
      0 36px 90px rgba(0, 0, 0, 0.6),
      0 0 130px rgba(255, 90, 71, 0.16);
  }
  .dkm-win :global(.lay-blur) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.03);
    pointer-events: none;
  }
  .dkm-digit {
    position: absolute;
    right: -8px;
    top: -46px;
    z-index: 0;
    pointer-events: none;
    user-select: none;
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    font-size: 150px;
    line-height: 0.82;
    letter-spacing: -0.045em;
    color: transparent;
    -webkit-text-stroke: 2px rgba(245, 240, 236, 0.1);
  }

  /* Szeroki układ flow (no-JS albo reduced-motion na desktopie):
     wygodniejszy padding boczny jak w About; pełna atmosfera wraca
     na desktopowym GPU. 861px = AUDIENCE_DESKTOP_MIN_PX. */
  @media (min-width: 861px) {
    .dk-stage {
      padding: 96px clamp(26px, 7vw, 120px) 84px;
    }
  }

  /* ═══ UKŁAD DESKTOP: przypięta scena (sticky) + stany scrolla ═══
     Wyłącznie przy dozwolonym ruchu i działającym JS (klasa .js) —
     861px = AUDIENCE_DESKTOP_MIN_PX (kontrakt z audience-config.ts). */
  @media (min-width: 861px) and (prefers-reduced-motion: no-preference) {
    .dk.js {
      height: var(--dklen);
    }
    .dk.js .dk-stage {
      position: sticky;
      top: 0;
      height: 100vh;
      display: block;
      padding: 0;
    }

    .dk.js .dk-ghostintro {
      font-size: min(13vw, 250px);
      left: 7.3vw;
      top: auto;
      bottom: 13vh;
    }
    .dk.js .dk-digitwrap {
      display: block;
    }
    .dk.js .dk-digit {
      left: 64vw;
      top: 8vh;
      font-size: min(41vw, 790px);
      z-index: 4;
      opacity: 0;
    }

    .dk.js .dk-tag {
      position: absolute;
      top: 8.8vh;
      left: 7.8vw;
    }
    .dk.js .dk-meta {
      display: flex;
      top: 8.8vh;
      right: 7.8vw;
    }
    .dk.js .dk-progress {
      display: flex;
      bottom: 7.6vh;
      left: 7.8vw;
    }

    .dk.js .dk-chapters {
      display: block;
      position: absolute;
      z-index: 7;
      left: 7.8vw;
      top: 50%;
      width: min(35vw, 680px);
      height: 0;
    }
    .dk.js .dk-ch {
      position: absolute;
      left: 0;
      top: 0;
      margin: 0;
      padding: 0;
      border: 0;
      gap: 26px;
    }
    .dk.js .dk-ch .ch-head {
      font-size: min(4.2vw, 80px);
    }
    .dk.js .dk-ch[data-ch="0"] .ch-head {
      font-size: min(5vw, 96px);
    }
    .dk.js .dk-ch .ch-para {
      font-size: clamp(15px, 0.94vw, 18px);
      max-width: 620px;
    }
    .dk.js .dkm-win,
    .dk.js .dkm-digit {
      display: none;
    }

    .dk.js .dk-backs {
      display: block;
      position: absolute;
      left: 58.5vw;
      top: 27vh;
      width: var(--dkcw);
      z-index: 4;
    }
    .dk.js .dk-stack {
      display: block;
      position: absolute;
      left: 58.5vw;
      top: 27vh;
      width: var(--dkcw);
      height: calc(var(--mkch, 46px) + var(--dkcw) * 0.6523);
      z-index: 5;
    }
    .dk.js .dk-card {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
    }
    .dk.js .dk-cap {
      display: flex;
      position: absolute;
      left: 2px;
      top: calc(100% + 26px);
      align-items: center;
      gap: 12px;
    }

    /* Stany startowe elementów sceny do czasu inicjalizacji modułu
       (gsap.set nadpisuje inline'ami) — bez tego pierwsza klatka po
       wolnym łączu pokazuje wszystkie karty/rozdziały naraz. */
    .dk.js .dk-card,
    .dk.js .dk-cap,
    .dk.js .dk-ch:not([data-ch="0"]) {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>
