---
// Okno „przeglądarki" karty-dowodu sekcji „Dla kogo".
// Wnętrze okna = wypieczony ekran referencyjny LUMÉA (WebP z
// scripts/capture-audience-screens.mjs; kadr 880×574 bez chrome'u).
// Chrome (pasek z URL) dorysowany DOM-owo w jasnym stylu LUMÉA — wektor,
// ostry w każdej skali. Całość dekoracyjna — aria-hidden nadaje rodzic
// (.dk-stack na desktop / .dkm-win na mobile). Zmienne --mkch/--rkp
// dziedziczone z korzenia sekcji (.dk w Audience.astro).
// Decyzje: docs/analiza-podmiana-ekranow-lumea-dla-kogo.md.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  screen: ImageMetadata;
  url: string; // adres w pasku (np. "lumea.pl/rezerwuj-wizyte")
  loading?: "lazy" | "eager";
}
const { screen, url, loading = "lazy" } = Astro.props;
---

<div class="mk-win">
  <div class="mk-chrome">
    <div class="mk-dots"><span></span><span></span><span></span></div>
    <div class="mk-url">
      <span class="mk-lock"></span><span class="mk-proto">https://</span>{url}
    </div>
    <div class="mk-menu"><i></i><i></i><i></i></div>
  </div>
  <div class="mk-body">
    <Image
      src={screen}
      alt=""
      widths={[440, 700, 880, 1400]}
      sizes="(min-width: 861px) 40vw, 92vw"
      loading={loading}
      decoding="async"
    />
  </div>
</div>

<style>
  /* Okno = jasna karta na ciemnej scenie. Tło #f7f1e8 (paper ekranu home),
     neutralny miękki cień (czerwona poświata placeholderów USUNIĘTA). */
  .mk-win {
    position: relative;
    width: 100%;
    border-radius: calc(16px * var(--rk, 1));
    background: #f7f1e8;
    overflow: hidden;
    box-shadow:
      inset 0 0 0 1px rgba(44, 38, 32, 0.08),
      0 36px 90px rgba(30, 20, 10, 0.45);
  }
  .mk-chrome {
    position: relative;
    z-index: 2;
    height: var(--mkch, 46px);
    display: flex;
    align-items: center;
    padding: 0 16px;
    border-bottom: 1px solid rgba(44, 38, 32, 0.1);
    background: #efe7db;
  }
  .mk-dots {
    display: flex;
    gap: 7px;
  }
  .mk-dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(44, 38, 32, 0.16);
  }
  .mk-dots span:first-child {
    background: #a9855a;
  }
  .mk-url {
    flex: 1 1 auto;
    min-width: 0;
    margin-left: 14px;
    display: flex;
    align-items: center;
    gap: 7px;
    height: max(20px, calc(var(--mkch, 46px) - 20px));
    padding: 0 11px;
    border-radius: var(--rkp, 99px);
    background: rgba(255, 255, 255, 0.62);
    font-family: var(--font-mono), monospace;
    font-size: 9px;
    letter-spacing: 0.05em;
    /* Kontrast AA (≥4.5:1) — podgląd intro (.dk-backs) jest widoczny od startu
       na desktopie, więc drobny tekst paska URL musi spełniać WCAG (axe bramkuje
       critical/serious). Hierarchia proto<domena zachowana w granicach AA. */
    color: rgba(44, 38, 32, 0.8);
    white-space: nowrap;
    overflow: hidden;
    text-transform: lowercase;
  }
  .mk-url .mk-proto {
    color: rgba(44, 38, 32, 0.68);
  }
  .mk-lock {
    width: 7px;
    height: 6px;
    border-radius: 1.5px;
    background: rgba(44, 38, 32, 0.4);
    position: relative;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .mk-lock::before {
    content: "";
    position: absolute;
    left: 1px;
    top: -4px;
    width: 5px;
    height: 5px;
    box-sizing: border-box;
    border: 1px solid rgba(44, 38, 32, 0.4);
    border-bottom: none;
    border-radius: 3px 3px 0 0;
  }
  .mk-menu {
    display: flex;
    flex-direction: column;
    gap: 2.5px;
    margin-left: 14px;
    flex-shrink: 0;
  }
  .mk-menu i {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(44, 38, 32, 0.32);
  }
  /* Wnętrze okna: obraz definiuje wysokość (natywny kadr 880×574). */
  .mk-body {
    position: relative;
    background: #f7f1e8;
  }
  .mk-body :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
