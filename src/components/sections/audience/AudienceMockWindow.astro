---
// Mockup okna przeglądarki — karty-dowody sekcji „Dla kogo" (desktop).
// Port <template>'ów i dla-kogo-mocks.css z referencji
// (docs/design/dla-kogo-referencja/) renderowany STATYCZNIE przez Astro
// (bez stemplowania JS — decyzja portu: docs/analiza-sekcja-dla-kogo.md §II.1).
// Kanwa treści ma stałe 880×574 px i jest skalowana do szerokości okna
// (fitMocks w audience-scroll.ts). Teksty wewnątrz mocka celowo PO POLSKU
// w obu wersjach językowych (decyzja §II.3); całość jest dekoracyjna —
// aria-hidden nadaje rodzic (.dk-stack).
interface Props {
  kind: "wow" | "cms" | "tools";
  label: string;
}
const { kind, label } = Astro.props;

// Siatka kalendarza rezerwacji: 28 komórek, zaznaczona „14" (i === 9),
// akcentowane co piąta (wzór `(i*7)%5===0` z referencji ≡ `i%5===0`).
const gridCells = Array.from({ length: 28 }, (_, i) => ({
  sel: i === 9,
  alt: i !== 9 && i % 5 === 0,
}));
---

<div class="mk-win mk-anim">
  <div class="mk-chrome">
    <div class="mk-dots"><span></span><span></span><span></span></div>
    <div class="mk-url">
      <span class="mk-lock"></span><span class="mk-proto">https://</span
      >twoja-firma.pl
    </div>
    <div class="mk-menu"><i></i><i></i><i></i></div>
  </div>
  <div class="mk-body">
    <div class="mk-fit">
      {
        kind === "wow" && (
          <div style="position:absolute;inset:0;background:#0B0709;">
            <div style="position:absolute;right:-140px;top:-170px;width:540px;height:540px;border-radius:50%;background:radial-gradient(closest-side, rgba(214,38,38,0.45), rgba(0,0,0,0) 72%);filter:blur(34px);" />
            <div style="position:absolute;left:56px;right:56px;top:30px;display:flex;align-items:center;justify-content:space-between;">
              <div style="display:flex;align-items:center;gap:10px;">
                <span class="dot" style="background:#FF5A47;" />
                <span class="b" style="width:74px;height:8px;--o:0.3;" />
              </div>
              <div style="display:flex;gap:16px;">
                <span class="b" style="width:44px;height:6px;--o:0.2;" />
                <span class="b" style="width:44px;height:6px;--o:0.2;" />
                <span class="b" style="width:44px;height:6px;--o:0.2;" />
              </div>
            </div>
            <div style="position:absolute;left:56px;top:140px;display:flex;flex-direction:column;gap:18px;align-items:flex-start;">
              <span class="mklab" style="letter-spacing:0.4em;color:#FF5A47;">
                STUDIO / TWOJA BRANŻA
              </span>
              <span
                class="b"
                style="width:470px;height:38px;--o:0.2;border-radius:calc(8px * var(--rk, 1));"
              />
              <span
                class="b"
                style="width:330px;height:38px;--o:0.2;border-radius:calc(8px * var(--rk, 1));"
              />
              <div style="display:flex;flex-direction:column;gap:9px;margin-top:6px;">
                <span class="b" style="width:340px;height:9px;--o:0.1;" />
                <span class="b" style="width:296px;height:9px;--o:0.1;" />
              </div>
              <div style="margin-top:14px;display:flex;align-items:center;justify-content:center;width:190px;height:46px;border-radius:var(--rkp, 99px);border:1px solid #FF5A47;">
                <span class="mklab" style="letter-spacing:0.3em;color:#FF5A47;">
                  ZOBACZ WIĘCEJ →
                </span>
              </div>
            </div>
            <div style="position:absolute;right:104px;top:214px;width:230px;height:150px;border-radius:calc(14px * var(--rk, 1));box-shadow:inset 0 0 0 1px rgba(245,240,236,0.06);transform:rotate(-7deg);opacity:0.25;" />
            <div style="position:absolute;right:126px;top:198px;width:230px;height:150px;border-radius:calc(14px * var(--rk, 1));box-shadow:inset 0 0 0 1px rgba(245,240,236,0.10);transform:rotate(-2deg);opacity:0.5;" />
            <div style="position:absolute;right:148px;top:182px;width:230px;height:150px;border-radius:calc(14px * var(--rk, 1));background:rgba(245,240,236,0.05);box-shadow:inset 0 0 0 1px rgba(245,240,236,0.14);transform:rotate(3deg);">
              <div style="position:absolute;left:16px;bottom:14px;display:flex;flex-direction:column;gap:7px;">
                <span class="b" style="width:110px;height:8px;--o:0.3;" />
                <span class="b" style="width:70px;height:8px;--o:0.14;" />
              </div>
              <span style="position:absolute;right:14px;top:12px;width:8px;height:8px;background:#FF5A47;transform:rotate(45deg);" />
            </div>
            <span style="position:absolute;right:372px;top:168px;width:6px;height:6px;background:#FF5A47;transform:rotate(45deg);opacity:0.7;" />
            <div class="mkw-mq">
              <div class="mq-i">
                <span>
                  PŁYNNE ANIMACJE — DOPRACOWANY DETAL — NIESZABLONOWY PROJEKT —
                </span>
                <span>
                  PŁYNNE ANIMACJE — DOPRACOWANY DETAL — NIESZABLONOWY PROJEKT —
                </span>
              </div>
            </div>
          </div>
        )
      }
      {
        kind === "cms" && (
          <div style="position:absolute;inset:0;background:#0C0809;">
            <div style="position:absolute;left:0;top:0;bottom:0;width:200px;border-right:1px solid rgba(245,240,236,0.08);background:rgba(245,240,236,0.02);padding:26px 20px;">
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:30px;">
                <span class="dot" style="background:#FF5A47;" />
                <span class="b" style="width:84px;height:9px;--o:0.32;" />
              </div>
              <div style="display:flex;flex-direction:column;gap:8px;">
                <div style="padding:9px 12px;border-radius:calc(8px * var(--rk, 1));background:rgba(255,90,71,0.10);box-shadow:inset 2px 0 0 #FF5A47;">
                  <span
                    class="mklab"
                    style="letter-spacing:0.18em;color:#F5F0EC;"
                  >
                    STRONA GŁÓWNA
                  </span>
                </div>
                <div style="padding:9px 12px;">
                  <span
                    class="mklab"
                    style="letter-spacing:0.18em;color:rgba(245,240,236,0.38);"
                  >
                    OFERTA
                  </span>
                </div>
                <div style="padding:9px 12px;">
                  <span
                    class="mklab"
                    style="letter-spacing:0.18em;color:rgba(245,240,236,0.38);"
                  >
                    GALERIA
                  </span>
                </div>
                <div style="padding:9px 12px;">
                  <span
                    class="mklab"
                    style="letter-spacing:0.18em;color:rgba(245,240,236,0.38);"
                  >
                    CENNIK
                  </span>
                </div>
                <div style="padding:9px 12px;">
                  <span
                    class="mklab"
                    style="letter-spacing:0.18em;color:rgba(245,240,236,0.38);"
                  >
                    KONTAKT
                  </span>
                </div>
              </div>
              <div style="position:absolute;left:20px;bottom:22px;display:flex;align-items:center;gap:9px;">
                <span style="width:22px;height:22px;border-radius:50%;background:rgba(245,240,236,0.12);" />
                <span class="b" style="width:70px;height:7px;--o:0.18;" />
              </div>
            </div>
            <div style="position:absolute;left:200px;right:0;top:0;bottom:0;padding:26px 34px;">
              <div style="display:flex;align-items:center;justify-content:space-between;">
                <span
                  class="mklab"
                  style="font-size:10px;color:rgba(245,240,236,0.62);"
