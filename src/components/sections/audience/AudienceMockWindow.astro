                  EDYCJA — STRONA GŁÓWNA
                </span>
                <div style="display:flex;align-items:center;gap:8px;padding:6px 12px;border-radius:var(--rkp, 99px);border:1px solid rgba(245,240,236,0.14);">
                  <span
                    class="dot"
                    style="width:7px;height:7px;background:#FF5A47;"
                  />
                  <span
                    class="mklab"
                    style="letter-spacing:0.2em;color:rgba(245,240,236,0.45);"
                  >
                    OPUBLIKOWANO
                  </span>
                </div>
              </div>
              <div style="position:absolute;right:34px;top:66px;padding:7px 13px;border-radius:calc(9px * var(--rk, 1));border:1px solid rgba(255,90,71,0.35);background:rgba(16,10,12,0.9);">
                <span
                  class="mklab"
                  style="letter-spacing:0.18em;color:#FF5A47;"
                >
                  ✓ ZAPISANO PRZED CHWILĄ
                </span>
              </div>
              <div
                class="mklab"
                style="margin-top:34px;letter-spacing:0.24em;color:rgba(245,240,236,0.38);"
              >
                NAGŁÓWEK SEKCJI
              </div>
              <div style="margin-top:10px;height:54px;border-radius:calc(10px * var(--rk, 1));background:rgba(245,240,236,0.06);box-shadow:inset 0 0 0 1px #FF5A47;display:flex;align-items:center;gap:4px;padding:0 16px;">
                <span class="b" style="width:150px;height:14px;--o:0.45;" />
                <span style="display:block;background:rgba(255,90,71,0.30);border-radius:calc(3px * var(--rk, 1));padding:5px 6px;margin-left:6px;">
                  <span class="b" style="width:96px;height:14px;--o:0.55;" />
                </span>
                <span class="mkc-caret" />
                <span
                  class="mklab"
                  style="margin-left:auto;letter-spacing:0.2em;color:rgba(245,240,236,0.3);"
                >
                  EDYTUJESZ…
                </span>
              </div>
              <div
                class="mklab"
                style="margin-top:24px;letter-spacing:0.24em;color:rgba(245,240,236,0.38);"
              >
                TREŚĆ AKAPITU
              </div>
              <div style="margin-top:12px;display:flex;gap:24px;">
                <div style="display:flex;flex-direction:column;gap:11px;">
                  <span class="b" style="width:340px;height:10px;--o:0.12;" />
                  <span class="b" style="width:312px;height:10px;--o:0.12;" />
                  <span class="b" style="width:340px;height:10px;--o:0.12;" />
                  <span class="b" style="width:268px;height:10px;--o:0.12;" />
                  <span class="b" style="width:300px;height:10px;--o:0.12;" />
                </div>
                <div style="width:236px;height:146px;border-radius:calc(12px * var(--rk, 1));border:1px dashed rgba(245,240,236,0.22);background:rgba(245,240,236,0.03);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;">
                  <span style="font-family:var(--font-mono),monospace;font-size:15px;color:rgba(245,240,236,0.5);">
                    ↑
                  </span>
                  <span
                    class="mklab"
                    style="font-size:8.5px;letter-spacing:0.24em;color:rgba(245,240,236,0.4);"
                  >
                    PODMIEŃ ZDJĘCIE
                  </span>
                </div>
              </div>
              <div style="position:absolute;left:234px;right:34px;bottom:26px;display:flex;align-items:center;justify-content:space-between;">
                <span
                  class="mklab"
                  style="letter-spacing:0.2em;color:rgba(245,240,236,0.32);"
                >
                  ZAPIS AUTOMATYCZNY — WŁĄCZONY
                </span>
                <div style="width:176px;height:44px;border-radius:calc(10px * var(--rk, 1));background:#FF5A47;display:flex;align-items:center;justify-content:center;">
                  <span
                    class="mklab"
                    style="font-size:10px;color:#1A0B08;font-weight:700;"
                  >
                    OPUBLIKUJ ZMIANY
                  </span>
                </div>
              </div>
            </div>
          </div>
        )
      }
      {
        kind === "tools" && (
          <div style="position:absolute;inset:0;background:#0B0709;">
            <div style="position:absolute;left:-120px;top:140px;width:460px;height:460px;border-radius:50%;background:radial-gradient(closest-side, rgba(130,20,32,0.4), rgba(0,0,0,0) 72%);filter:blur(30px);" />
            <div
              class="mkt-card"
              style="left:62px;top:80px;width:330px;height:318px;transform:rotate(-2deg);"
            >
              <div style="display:flex;justify-content:space-between;margin-bottom:16px;">
                <span class="mklab">REZERWACJE</span>
                <span class="mklab" style="color:rgba(245,240,236,0.38);">
                  PAŹDZIERNIK
                </span>
              </div>
              <div class="mkt-grid">
                {gridCells.map((c) =>
                  c.sel ? (
                    <span class="sel">14</span>
                  ) : c.alt ? (
                    <span class="alt" />
                  ) : (
                    <span />
                  ),
                )}
              </div>
              <div style="margin-top:16px;">
                <span
                  class="mklab"
                  style="font-size:8.5px;letter-spacing:0.2em;color:#FF5A47;"
                >
                  WT 14 — 14:30 · POTWIERDZONA
                </span>
              </div>
            </div>
            <div
              class="mkt-card"
              style="left:452px;top:54px;width:318px;height:272px;transform:rotate(2deg);"
            >
              <div class="mklab" style="margin-bottom:18px;">
                KONFIGURATOR USŁUGI
              </div>
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:15px;">
                <span class="b" style="width:120px;height:9px;--o:0.2;" />
                <span class="tg on">
                  <i />
                </span>
              </div>
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:15px;">
                <span class="b" style="width:94px;height:9px;--o:0.2;" />
                <span class="tg">
                  <i />
                </span>
              </div>
              <div style="position:relative;height:14px;margin-bottom:16px;">
                <span style="position:absolute;left:0;right:0;top:6px;height:4px;border-radius:var(--rkp, 99px);background:rgba(245,240,236,0.10);" />
                <span style="position:absolute;left:0;width:58%;top:6px;height:4px;border-radius:var(--rkp, 99px);background:#FF5A47;" />
                <span style="position:absolute;left:58%;top:0;width:14px;height:14px;border-radius:50%;background:#F5F0EC;box-shadow:0 0 12px rgba(255,90,71,0.8);" />
              </div>
              <div style="border-top:1px solid rgba(245,240,236,0.10);padding-top:14px;display:flex;align-items:baseline;justify-content:space-between;">
                <span class="mklab" style="color:rgba(245,240,236,0.38);">
                  SUMA
                </span>
                <span style="font-family:var(--font-display),sans-serif;font-weight:800;font-size:22px;letter-spacing:-0.02em;color:#F5F0EC;">
                  2 400 ZŁ
                </span>
              </div>
            </div>
            <div
              class="mkt-card"
              style="left:420px;top:362px;width:352px;height:158px;transform:rotate(-1deg);padding:18px;"
            >
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:13px;">
                <span class="mklab">SPRZEDAŻ ONLINE</span>
                <span style="font-family:var(--font-mono),monospace;font-size:10px;letter-spacing:0.14em;color:#F5F0EC;">
                  149 ZŁ / SZT.
                </span>
              </div>
              <div style="height:40px;border-radius:calc(10px * var(--rk, 1));background:#FF5A47;display:flex;align-items:center;justify-content:center;margin-bottom:10px;">
                <span
                  class="mklab"
                  style="font-size:10px;color:#1A0B08;font-weight:700;letter-spacing:0.24em;"
                >
                  KUP TERAZ →
                </span>
              </div>
              <span
                class="mklab"
                style="font-size:8px;letter-spacing:0.24em;color:rgba(245,240,236,0.3);"
              >
                BLIK · KARTA · PRZELEW
              </span>
            </div>
          </div>
        )
      }
    </div>
  </div>
  <div class="mk-tag">{label}</div>
</div>

<style>
  /* Port dla-kogo-mocks.css (referencja). Okno: .mk-win > .mk-chrome +
     .mk-body > .mk-fit (kanwa 880×574, skalowana JS-em do szerokości).
     .mk-anim = żywe animacje wewnątrz mocka (marquee, kursor) — bramkowane
     niżej na desktop + no-preference. Zmienne --rk/--rkp/--mkch dziedziczone
     z korzenia sekcji (.dk w Audience.astro). */
  .mk-win {
    position: relative;
    width: 100%;
    border-radius: calc(16px * var(--rk, 1));
    background: #0d090b;
    overflow: hidden;
    box-shadow:
      inset 0 0 0 1px rgba(245, 240, 236, 0.1),
      0 36px 90px rgba(0, 0, 0, 0.6),
      0 0 130px rgba(255, 90, 71, 0.16);
  }
  .mk-chrome {
    position: relative;
    z-index: 2;
    height: var(--mkch, 46px);
    display: flex;
    align-items: center;
    padding: 0 16px;
    border-bottom: 1px solid rgba(245, 240, 236, 0.08);
    background: rgba(245, 240, 236, 0.025);
  }
  .mk-dots {
    display: flex;
    gap: 7px;
  }
  .mk-dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(245, 240, 236, 0.18);
  }
  .mk-dots span:first-child {
    background: rgba(255, 90, 71, 0.8);
  }
  .mk-url {
    flex: 1 1 auto;
    min-width: 0;
    margin-left: 14px;
    display: flex;
    align-items: center;
    gap: 7px;
    height: max(20px, calc(var(--mkch, 46px) - 20px));
    padding: 0 11px;
    border-radius: var(--rkp, 99px);
    background: rgba(245, 240, 236, 0.05);
    font-family: var(--font-mono), monospace;
    font-size: 9px;
    letter-spacing: 0.05em;
    color: rgba(245, 240, 236, 0.5);
    white-space: nowrap;
    overflow: hidden;
    text-transform: lowercase;
  }
  .mk-url .mk-proto {
    color: rgba(245, 240, 236, 0.26);
  }
  .mk-lock {
    width: 7px;
    height: 6px;
    border-radius: 1.5px;
    background: rgba(245, 240, 236, 0.38);
    position: relative;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .mk-lock::before {
    content: "";
    position: absolute;
    left: 1px;
    top: -4px;
    width: 5px;
    height: 5px;
    box-sizing: border-box;
    border: 1px solid rgba(245, 240, 236, 0.38);
    border-bottom: none;
    border-radius: 3px 3px 0 0;
  }
  .mk-menu {
    display: flex;
    flex-direction: column;
    gap: 2.5px;
    margin-left: 14px;
    flex-shrink: 0;
  }
  .mk-menu i {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(245, 240, 236, 0.3);
  }
  .mk-body {
    position: relative;
    aspect-ratio: 880 / 574;
    background: #0b0709;
    overflow: hidden;
  }
  .mk-fit {
    position: absolute;
    left: 0;
    top: 0;
    width: 880px;
    height: 574px;
    transform-origin: 0 0;
  }
  .mk-tag {
    position: absolute;
    right: 16px;
    top: calc(var(--mkch, 46px) + 14px);
    z-index: 3;
    font-family: var(--font-mono), monospace;
    font-size: 9px;
    letter-spacing: 0.26em;
    color: rgba(245, 240, 236, 0.55);
    padding: 6px 12px;
    border-radius: var(--rkp, 99px);
    border: 1px solid rgba(245, 240, 236, 0.16);
    background: rgba(10, 7, 9, 0.65);
    text-transform: uppercase;
  }

  /* prymitywy skeletonu */
  .mk-fit :global(.b) {
    display: block;
    background: rgba(245, 240, 236, var(--o, 0.16));
    border-radius: calc(6px * var(--rk, 1));
    flex-shrink: 0;
  }
  .mk-fit :global(.dot) {
    display: block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .mk-fit :global(.mklab) {
    font-family: var(--font-mono), monospace;
    font-size: 9px;
    letter-spacing: 0.22em;
    color: rgba(245, 240, 236, 0.6);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* przełącznik */
  .mk-fit :global(.tg) {
    position: relative;
    width: 34px;
    height: 18px;
    border-radius: var(--rkp, 99px);
    background: rgba(245, 240, 236, 0.12);
    flex-shrink: 0;
  }
  .mk-fit :global(.tg i) {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: rgba(245, 240, 236, 0.5);
  }
  .mk-fit :global(.tg.on) {
    background: rgba(255, 90, 71, 0.9);
  }
  .mk-fit :global(.tg.on i) {
    left: 18px;
    background: #1a0b08;
  }

  /* karta narzędziowa (tools) */
  .mk-fit :global(.mkt-card) {
    position: absolute;
    border-radius: calc(14px * var(--rk, 1));
    background: #130d10;
    padding: 20px;
    box-sizing: border-box;
    box-shadow:
      inset 0 0 0 1px rgba(245, 240, 236, 0.1),
      0 24px 60px rgba(0, 0, 0, 0.5);
  }
  .mk-fit :global(.mkt-grid) {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 7px;
  }
  .mk-fit :global(.mkt-grid span) {
    height: 26px;
    border-radius: calc(6px * var(--rk, 1));
    background: rgba(245, 240, 236, 0.05);
  }
  .mk-fit :global(.mkt-grid span.alt) {
    background: rgba(245, 240, 236, 0.09);
  }
  .mk-fit :global(.mkt-grid span.sel) {
    background: #ff5a47;
    box-shadow: 0 0 18px rgba(255, 90, 71, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono), monospace;
    font-size: 8px;
    font-weight: 700;
    color: #1a0b08;
