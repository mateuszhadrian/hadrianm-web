---
// Fonty strony drewelomet (makiety ekranów laptopa i telefonu w scenie
// urządzeń) — importowane TU, nie w BaseLayout: Hero renderuje się wyłącznie
// na stronie głównej (Home.astro), więc pozostałe 18 podstron nie musi
// pobierać tych reguł @font-face. Pliki woff2 ściągają się dopiero gdy krój
// jest realnie użyty; LaptopSite chowa się <760px, ale PhoneSite renderuje
// się na mobile i używa OBU krojów.
import "@fontsource/saira-condensed/latin-600.css";
import "@fontsource/saira-condensed/latin-ext-600.css";
import "@fontsource/space-mono/latin-400.css";

import { useTranslations, type Lang } from "@/i18n/utils";
import DeviceScene from "./DeviceScene.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const accentLetters = [...t("hero.headlineAccent")];
const accentN = accentLetters.length;

const s1LeadLines = t("hero.s1Lead").split("\n");
const s1Accent = t("hero.s1Accent");
const copyRows = [
  t("hero.s2"),
  t("hero.s3"),
  t("hero.s4"),
  t("hero.s6"),
  t("hero.s7"),
].map((s, idx) => ({
  num: String(idx + 2).padStart(2, "0"),
  lines: s.split("\n"),
}));

const splitAccent = (line: string) =>
  line.split("*").map((part, j) => ({
    text: part.replace(/^!/, ""),
    em: j % 2 === 1,
    lg: j % 2 === 1 && part.startsWith("!"),
  }));
---

<section id="hero" class="hero">
  <div class="hero__stage">
    <div class="hero__head">
      <p class="hero__eyebrow">{t("hero.eyebrow")}</p>
      <h1 class="hero__headline">
        {t("hero.headlineLead")}{" "}
        <span class="hero__accent hero__accent--ghost" style={`--n:${accentN}`}>
          {
            accentLetters.map((ch, i) => (
              <span class="hero__accent-ltr" style={`--i:${i}`}>
                {ch === " " ? " " : ch}
              </span>
            ))
          }
        </span>
      </h1>

      <div class="hero__scroll">
        <span class="hero__scroll-label">{t("hero.scroll")}</span>
        <span class="hero__scroll-line" aria-hidden="true"></span>
      </div>
    </div>

    <span
      class="hero__accent hero__accent--live"
      aria-hidden="true"
      style={`--n:${accentN}`}
    >
      {
        accentLetters.map((ch, i) => (
          <span class="hero__accent-ltr" style={`--i:${i}`}>
            {ch === " " ? " " : ch}
          </span>
        ))
      }
    </span>

    <div class="hero__copy">
      <div class="hero__copy-row hero__copy-row--1">
        <span class="hero__copy-num">01</span>
        <p class="hero__copy-text">
          {
            s1LeadLines.map((line, i) => (
              <Fragment>
                {i > 0 && <br />}
                {line}
                {i === s1LeadLines.length - 1 && (
                  <Fragment>
                    {" "}
                    <em>{s1Accent}</em>
                  </Fragment>
                )}
              </Fragment>
            ))
          }
        </p>
      </div>
      {
        copyRows.map((row, idx) => (
          <div class={`hero__copy-row hero__copy-row--${idx + 2}`}>
            <span class="hero__copy-num">{row.num}</span>
            <p class="hero__copy-text">
              {row.lines.map((line, i) => (
                <Fragment>
                  {i > 0 && <br />}
                  <span
                    class={
                      i === 0
                        ? "hero__copy-ln"
                        : "hero__copy-ln hero__copy-ln--cont"
                    }
                  >
                    {splitAccent(line).map((p) =>
                      p.em ? (
                        <em class={p.lg ? "is-lg" : undefined}>{p.text}</em>
                      ) : (
                        p.text
                      ),
                    )}
                  </span>
                </Fragment>
              ))}
            </p>
          </div>
        ))
      }
    </div>

    <div class="hero__devices" aria-hidden="true">
      <DeviceScene />
    </div>

    <div class="hero__progress" aria-hidden="true">
      <span class="hero__progress-track"
        ><i class="hero__progress-fill"></i></span
      >
      <span class="hero__progress-dot"></span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;

    --headline-size: clamp(2.75rem, 7.9vw, 9.4rem);
  }

  .hero__stage {
    position: relative;
  }

  .hero__head {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1.5rem, 2.1vw, 2.5rem);
    padding: 0 clamp(1.5rem, 9.4vw, 11.25rem);
    text-align: center;
  }

  .hero__eyebrow {
    margin: 0;
    font-family: var(--font-mono), monospace;
    font-size: clamp(0.62rem, 0.66vw, 0.75rem);
    letter-spacing: 0.44em;
    text-indent: 0.44em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .hero__headline {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    font-size: var(--headline-size);
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--ink);
    text-wrap: balance;
  }

  .hero__accent {
    --n: 1;
    font-family: var(--font-serif), serif;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    white-space: nowrap;
  }
  .hero__headline .hero__accent {
    font-size: 1.06em;
  }
  .hero__accent--live {
    display: none;
    font-size: calc(var(--headline-size) * 1.06);
  }

  .hero__accent-ltr {
    --i: 0;
    display: inline-block;
    padding: 0.3em 0.36em;
    margin: -0.3em -0.36em;
    background: var(--accent-gradient)
      calc(var(--i) / max(var(--n) - 1, 1) * 100%) 50% / calc(var(--n) * 100%)
      100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: accent-wave 2.4s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.08s);
    will-change: transform;
  }
  .hero__accent--live.is-wave-paused .hero__accent-ltr {
    animation-play-state: paused;
  }

  .hero__scroll {
    position: absolute;
    bottom: clamp(1.25rem, 4vh, 2.75rem);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .hero__scroll-label {
    font-family: var(--font-mono), monospace;
    font-size: clamp(0.6rem, 0.6vw, 0.7rem);
    letter-spacing: 0.34em;
    text-indent: 0.34em;
    color: var(--faint);
  }
  .hero__scroll-line {
    width: 1px;
    height: clamp(2rem, 4.25vh, 2.875rem);
    background: linear-gradient(
      180deg,
      var(--accent) 0%,
      rgba(0, 0, 0, 0) 100%
    );
    transform-origin: top;
    animation: scroll-pulse 2.4s ease-in-out infinite;
  }

  .hero__copy {
    max-width: 40rem;
    margin: 0 auto;
    padding: clamp(2rem, 7vw, 5rem);
    display: flex;
    flex-direction: column;
  }
  .hero__copy-row {
    display: flex;
    gap: clamp(0.85rem, 1.4vw, 1.4rem);
    align-items: baseline;
  }
  .hero__copy-row--2,
  .hero__copy-row--3 {
    border-top: 1px solid var(--line);
    margin-top: clamp(1.1rem, 2vw, 1.65rem);
    padding-top: clamp(1.1rem, 2vw, 1.65rem);
  }
  .hero__copy-num {
    flex-shrink: 0;
    font-family: var(--font-mono), monospace;
    font-size: clamp(0.7rem, 0.8vw, 0.82rem);
    color: var(--accent);
  }
  .hero__copy-text {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-display), sans-serif;
    font-weight: 600;
    font-size: clamp(1rem, 1.45vw, 1.65rem);
    line-height: 1.3;
    text-wrap: balance;
  }
  .hero__copy-row--1 .hero__copy-text {
    color: var(--ink);
    font-weight: 800;
    font-size: clamp(2rem, 3.9vw, 3.75rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  .hero__copy-text em {
    font-family: var(--font-serif), serif;
    font-style: italic;
    font-weight: 400;
    font-size: 1.06em;
    letter-spacing: 0;
    padding-inline: 0.12em;
    margin-inline: -0.12em;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .hero__copy-text em.is-lg {
    font-size: 1.5em;
  }
  .hero__copy:not(.is-carousel) .hero__copy-row--4,
  .hero__copy:not(.is-carousel) .hero__copy-row--5,
  .hero__copy:not(.is-carousel) .hero__copy-row--6,
  .hero__copy:not(.is-carousel) .hero__copy-row--7 {
    display: none;
  }

  /* ─────────────────────────── SCENA URZĄDZEŃ (slot) ─────────────────────── */
  .hero__devices {
    position: relative;
    min-height: 100svh;
  }

  /* ───────────────── TRYB ANIMACJI (ruch dozwolony) ───────────────── */
  @media (prefers-reduced-motion: no-preference) {
    .hero {
      min-height: 700svh;
    }
    .hero__stage {
      position: sticky;
      top: 0;
      height: 100svh;
      overflow: clip;
    }
    .hero__head {
      position: absolute;
      inset: 0;
      min-height: auto;
      will-change: transform;
    }
    .hero__devices {
      position: absolute;
      inset: 0;
      min-height: auto;
      opacity: 0;
      will-change: transform, opacity;
    }
    .hero__accent--live {
      display: block;
      position: absolute;
      left: 0;
      top: 0;
      opacity: 0;
      z-index: 5;
      transform-origin: 50% 50%;
      pointer-events: none;
      will-change: transform, opacity;
    }

    .hero__copy {
      position: absolute;
      top: 50%;
      left: clamp(2.5rem, 7.5vw, 9.5rem);
      transform: translateY(-50%);
      width: clamp(18rem, 31vw, 31rem);
      max-width: none;
      margin: 0;
      padding: 0;
      opacity: 0;
      z-index: 4;
      pointer-events: none;
      will-change: transform, opacity;
    }

    .hero__copy.is-carousel {
      overflow-x: visible;
      overflow-y: clip;
    }
    .hero__copy.is-carousel .hero__copy-row {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      margin: 0;
      padding: 0;
      will-change: transform;
    }
    .hero__copy.is-carousel .hero__copy-row:not(.hero__copy-row--1) {
      border-top: 1px solid var(--line);
    }
    .hero__copy.is-carousel .hero__copy-text {
      color: var(--ink);
      white-space: nowrap;
    }
  }

  /* ─────────────────────── WSKAŹNIK POSTĘPU (mobile) ───────────────────────
     Domyślnie ukryty; odsłaniany wyłącznie w mobilnej gałęzi ruchu poniżej. */
  .hero__progress {
    display: none;
  }

  /* 760 = MOBILE_MAX (platform.ts) — zmieniaj razem */
  @media (prefers-reduced-motion: no-preference) and (max-width: 760px) {
    /* Wartość wstępna (przed hydracją); finalną, krótszą ustawia <script>
       (MOBILE_MIN_HEIGHT_SVH — pochodna w hero-config.ts). */
    .hero {
      min-height: 1500svh;
    }

    .hero__progress {
      --p: 0;
      --bar-shift-y: -6svh;
      display: block;
      position: absolute;
      top: 50%;
      right: 12px;
      height: 72svh;
      width: 14px;
      transform: translateY(calc(-50% + var(--bar-shift-y)));
      /* POD urządzeniami (5): pasek startuje już podczas wjazdu telefonu
         z prawej — telefon ma go zasłaniać, nie przecinać. Remis z copy (4)
         rozstrzyga kolejność DOM (pasek później) → nadal nad dividerami. */
      z-index: 4;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.15s ease;
    }
    .hero__progress.is-active {
      opacity: 1;
    }
    .hero__progress-track {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 2px;
      transform: translateX(-50%);
      background: var(--line);
      border-radius: 1px;
      z-index: 0;
    }
    /* Przebyta część + romb na czole — lustro nici procesu w Services.astro
       (.of-fill / .of-node.lit); tam zmiana wyglądu = zmiana i tutaj. */
    .hero__progress-fill {
      position: absolute;
      inset: 0;
      transform-origin: 50% 0;
      transform: scaleY(var(--p));
      will-change: transform;
      background: linear-gradient(
        180deg,
        rgba(255, 90, 71, 0.25),
        var(--accent)
      );
      box-shadow: 0 0 18px rgba(var(--glow), 0.45);
    }
    .hero__progress-dot {
      position: absolute;
      left: 50%;
      top: calc(var(--p) * 100%);
      width: 13px;
      height: 13px;
      background: var(--accent);
      box-shadow: 0 0 22px rgba(var(--glow), 0.75);
      transform: translate(-50%, -50%) rotate(45deg);
      z-index: 3;
    }
    .hero__devices {
      z-index: 5;
    }
    .hero__copy {
      position: absolute;
      inset: 0;
      width: auto;
      left: 0;
      top: 0;
      transform: none;
      padding: 0;
      opacity: 0;
      z-index: 4;
      pointer-events: none;
      will-change: opacity;
    }
    .hero__copy-row {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      width: min(86vw, 26rem);
      margin: 0;
    }
    .hero__copy-row--1 {
      top: 7svh;
    }
    .hero__copy-row--2 {
      top: 45svh;
    }
    .hero__copy-row--3 {
      top: 82svh;
    }
    .hero__copy-row--3 .hero__copy-text br {
      display: none;
    }
    .hero__copy-row--3 .hero__copy-ln--cont {
      text-transform: lowercase;
    }
    .hero__copy-row--3 .hero__copy-ln--cont::before {
      content: " ";
    }
    .hero__copy-row--4,
    .hero__copy-row--5,
    .hero__copy-row--6,
    .hero__copy-row--7 {
      display: none;
    }
  }

  /* 761 = MOBILE_MAX + 1 (platform.ts) — zmieniaj razem */
  @media (prefers-reduced-motion: no-preference) and (min-width: 761px) {
    .hero {
      /* Wartość wstępna (przed hydracją); finalną ustawia <script> jako
         POCHODNĄ osi scrolla (DESKTOP_MIN_HEIGHT_SVH w hero-config.ts —
         tam też pełne wyjaśnienie geometrii pin/scrub). Nie przeliczaj
         tej liczby ręcznie. Scrub leci dalej za odpięciem, więc resztka
         animacji urządzeń dogrywa się, gdy sekcja zjeżdża już w górę. */
      min-height: 1233svh;
    }
  }

  @keyframes scroll-pulse {
    0%,
    100% {
      opacity: 0.55;
      transform: scaleY(0.82);
    }
    50% {
      opacity: 1;
      transform: scaleY(1);
    }
  }

  @keyframes accent-wave {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-0.12em);
    }
  }

  @media (max-height: 600px) {
    .hero__eyebrow,
    .hero__scroll-label {
      display: none;
    }
    .hero {
      --headline-size: clamp(2.25rem, 6.4vw, 7.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line,
    .hero__accent-ltr {
      animation: none;
    }
  }
</style>

<script>
  // ORKIESTRATOR sceny hero (krok 4 refactoru — docs/analiza-refactor-hero-
  // odkruszenie.md). Logika żyje w modułach: timeline-base (scrub + refy),
  // desktop-phases / mobile-phases / caption-carousel (fazy), device-scene
  // (geometria 3D), android-mobile (faza 3 mobile: wideo + pasek),
  // hero-config (oś scrolla), platform (detekcja), scene-vars (protokół CSS).
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { initDeviceScene } from "./device-scene";
  import { initLaptopSite, type LaptopSiteApi } from "./laptop-site";
  import { initPhoneSite, type PhoneSiteApi } from "./phone-site";
  import { initMobilePhase3 } from "./android-mobile";
  import {
    IS_ANDROID,
    MOBILE_MQ,
    DESKTOP_MQ,
    ANDROID_DESIGN_SCALE,
  } from "./platform";
  import { setRest } from "./scene-vars";
  import { SEL, devWarnMissing } from "./selectors";
  import { q, buildBase, deviceRefs, cleanup } from "./timeline-base";
  import {
    phase1Desktop,
    phase2Desktop,
    phase3Desktop,
    phase3PhoneDesktop,
  } from "./desktop-phases";
  import { initCaptionCarousel } from "./caption-carousel";
  import {
    phase1Mobile,
    phase2Mobile,
    initCaptionGrowth,
    initDividers,
  } from "./mobile-phases";
  import {
    DESKTOP_SCREENS,
    DESKTOP_SCREENS_FALLBACK,
    DESKTOP_MIN_HEIGHT_SVH,
    SCROLL_SCALE,
    MOBILE_SCREENS,
    MOB_ENTRY_Z_PX,
    VID_MAX,
    GROW_END,
    HOLD_END,
    LAP_SPAN,
    PH_SPAN,
    BAR_START_SCREENS,
    BAR_END_SCREENS,
    MOBILE_MIN_HEIGHT_SVH,
  } from "./hero-config";

  gsap.registerPlugin(ScrollTrigger);

  ScrollTrigger.config({ ignoreMobileResize: true });

  // Klasa + wartość skali projektowej idą RAZEM i PRZED initDeviceScene
  // (dvar w device-scene.ts musi czytać już przeskalowane --ph-w/--ph-h).
  // CSS (DeviceScene.astro) robi z tej zmiennej --k wyłącznie pod
  // media query mobile + html.is-android — wartość żyje tylko w platform.ts.
  if (IS_ANDROID) {
    document.documentElement.classList.add("is-android");
    document.documentElement.style.setProperty(
      "--android-design-scale",
      String(ANDROID_DESIGN_SCALE),
    );
  }
  const devicesEl = q(SEL.devices);
  if (!devicesEl) devWarnMissing("devices");
  const scene = devicesEl ? initDeviceScene(devicesEl) : null;

  /* ── Animacja sterowana scrollem (tylko gdy ruch dozwolony) ── */
  const mm = gsap.matchMedia();

  // Wysokość sekcji = pochodna osi scrolla (hero-config.ts); wartości w CSS
  // (1233svh / 1500svh) są tylko wstępne. PX z window.innerHeight — tej samej
  // metryki, z której ScrollTrigger liczy end/okna — przeliczane przy każdym
  // refreshu (refreshInit). Sam svh nie wystarcza: późny refresh (window.load
  // po zimnym cache) przelicza scrub przy ZWINIĘTYM toolbarze iOS
  // (innerHeight ≈ +15%), a svh stoi w miejscu → sticky puszczał za wcześnie
  // (w połowie okna telefonu). Przy starcie px == wartość svh.
  const heroHeightSync = (hero: HTMLElement | null, svh: number) => {
    const set = () => {
      if (hero) hero.style.minHeight = (svh / 100) * window.innerHeight + "px";
    };
    set();
    ScrollTrigger.addEventListener("refreshInit", set);
    return () => {
      ScrollTrigger.removeEventListener("refreshInit", set);
      hero?.style.removeProperty("min-height");
    };
  };

  // ── DESKTOP/TABLET ──
  mm.add(`(prefers-reduced-motion: no-preference) and ${DESKTOP_MQ}`, () => {
    // Strona drewelomet na ekranie laptopa — inicjalizowana tylko na desktop/tablet.
    // Owinięte w try/catch: błąd inicjalizacji nie może zamrozić animacji Hero.
    const laptopRoot = q<HTMLElement>(SEL.laptopSiteRoot);
    if (!laptopRoot) devWarnMissing("laptopSiteRoot");
    let site: LaptopSiteApi | null = null;
    try {
      if (laptopRoot) site = initLaptopSite(laptopRoot);
    } catch (e) {
      console.error("[LaptopSite] init failed:", e);
      site = null;
    }

    const phoneRoot = q<HTMLElement>(SEL.phoneSiteRoot);
    if (!phoneRoot) devWarnMissing("phoneSiteRoot");
    let phoneSite: PhoneSiteApi | null = null;
    try {
      if (phoneRoot) phoneSite = initPhoneSite(phoneRoot);
    } catch (e) {
      console.error("[PhoneSite] init failed:", e);
      phoneSite = null;
    }

    const b = buildBase(site ? DESKTOP_SCREENS : DESKTOP_SCREENS_FALLBACK);
    if (!b) {
      site?.destroy();
      phoneSite?.destroy();
      return;
    }

    const heroHeightCleanup = heroHeightSync(
      q(SEL.hero),
      DESKTOP_MIN_HEIGHT_SVH,
    );

    const refs = deviceRefs();
    const captionCleanup = site ? initCaptionCarousel(b) : null;
    phase1Desktop(b);
    phase2Desktop(b, refs, scene);
    if (site) phase3Desktop(b, site);
    if (site && phoneSite) phase3PhoneDesktop(b, phoneSite);
    return () => {
      captionCleanup?.();
      cleanup(b)();
      site?.destroy();
      phoneSite?.destroy();
      heroHeightCleanup();
    };
  });

  // ── MOBILE ──
  mm.add(`(prefers-reduced-motion: no-preference) and ${MOBILE_MQ}`, () => {
    // Odchudzenie DOM: żywe podglądy stron (ciężkie poddrzewa + obrazy) są na
    // mobile niepotrzebne — ekrany napędza video. Usuwamy je całkiem z DOM.
    q(SEL.laptopSiteRoot)?.remove();
    q(SEL.phoneSiteRoot)?.remove();

    const b = buildBase(MOBILE_SCREENS * SCROLL_SCALE);
    if (!b) return;
    const refs = deviceRefs();
    const fitEl = q(SEL.fit);
    if (!fitEl) devWarnMissing("fit");

    const fitScale = () =>
      fitEl ? parseFloat(fitEl.style.getPropertyValue("--fit")) || 1 : 1;
    // offset poziomy ≈ szerokość viewportu / skala .fit (urządzenie za krawędzią)
    const slide = () =>
      (devicesEl?.clientWidth || window.innerWidth) / fitScale();
    // głębia wjazdu w jednostkach projektowych (≈ stała głębia ekranowa pod perspektywą)
    const zDepth = () => MOB_ENTRY_Z_PX / fitScale();

    phase1Mobile(b, refs, slide, zDepth);
    phase2Mobile(b, refs);

    const hero = q(SEL.hero);
    const setupVideo = (sel: string) => {
      const v = q<HTMLVideoElement>(sel);
      if (v && v.dataset.src && !v.src) {
        v.preload = "auto";
        v.src = v.dataset.src;
        v.load();
      }
      return v;
    };
    const stopReset = (v: HTMLVideoElement | null) => {
      if (!v) return;
      try {
        v.pause();
        v.currentTime = 0;
      } catch {
        /* noop */
      }
    };

    const lapVideo = setupVideo(SEL.videoLaptop);
    const phVideo = setupVideo(SEL.videoPhone);
    if (!lapVideo) devWarnMissing("videoLaptop");
    if (!phVideo) devWarnMissing("videoPhone");

    const heroHeightCleanup = heroHeightSync(hero, MOBILE_MIN_HEIGHT_SVH);
    const captionGrowthCleanup = initCaptionGrowth(hero);
    const cleanupDividers = initDividers(hero, refs);

    // ── Faza 3 (wspólna iOS + Android): ciągłe odtwarzanie w pętli +
    // pasek postępu z rombem — patrz android-mobile.ts.
    const progressEl = q(SEL.progress);
    if (!progressEl) devWarnMissing("progress");
    const phase3Cleanup = initMobilePhase3({
      hero,
      vidMax: VID_MAX,
      growEnd: GROW_END,
      holdEnd: HOLD_END,
      videos: [
        { video: lapVideo, el: refs.laptop, span: LAP_SPAN },
        { video: phVideo, el: refs.phone, span: PH_SPAN },
      ],
      progressEl,
      barStartVh: BAR_START_SCREENS,
      barEndVh: BAR_END_SCREENS,
    });

    return () => {
      cleanup(b)();
      phase3Cleanup();
      captionGrowthCleanup();
      cleanupDividers();
      heroHeightCleanup();
      stopReset(lapVideo);
      stopReset(phVideo);
      setRest(refs.laptop, ["--vid-scale", "--sl-lap", "--sz-lap"]);
      setRest(refs.phone, ["--vid-scale", "--sl-ph", "--sz-ph"]);
    };
  });
</script>
