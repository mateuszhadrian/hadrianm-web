---
// Sekcja „Oferta" — design „Nić A + Pakiety P4" (port referencji
// docs/design/oferta-referencja/; decyzje: docs/analiza-sekcja-oferta.md).
// Markup + style tutaj; animacje scrolla w services-scroll.ts (ładowane tylko
// przy prefers-reduced-motion: no-preference). Bez JS / przy reduce sekcja
// renderuje pełną, statyczną treść (stany startowe animacji siedzą w CSS pod
// media no-preference i klasą .js sekcji).
import { navItems, navLabel } from "@/i18n/nav";
import { useTranslations, type Lang } from "@/i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const item = navItems.find((n) => n.id === "services");
const label = item ? navLabel(item, lang) : "Oferta";

// Kickery „Krok 0X / 05" składane z i18n — treści kroków w ui.ts.
const stepWord = t("services.step");
const steps = [
  { head: t("services.st1.head"), para: t("services.st1.para") },
  { head: t("services.st2.head"), para: t("services.st2.para") },
  { head: t("services.st3.head"), para: t("services.st3.para") },
  { head: t("services.st4.head"), para: t("services.st4.para") },
  { head: t("services.st5.head"), para: t("services.st5.para") },
].map((s, i) => ({ ...s, kick: `${stepWord} 0${i + 1} / 05`, digit: i + 1 }));

// Cyfry-ghost cen są dekoracją (aria-hidden) — te same w obu językach.
const packages = [
  {
    ghost: "1500",
    no: `${t("services.pk.package")} 01`,
    name: t("services.pk1.name"),
    sub: t("services.pk1.sub"),
    price: t("services.pk1.price"),
    range: t("services.pk1.range"),
    feats: [
      t("services.pk1.f1"),
      t("services.pk1.f2"),
      t("services.pk1.f3"),
      t("services.pk1.f4"),
      t("services.pk1.f5"),
    ],
    star: null,
    mid: false,
  },
  {
    ghost: "3500",
    no: `${t("services.pk.package")} 02`,
    name: t("services.pk2.name"),
    sub: t("services.pk2.sub"),
    price: t("services.pk2.price"),
    range: t("services.pk2.range"),
    feats: [
      t("services.pk2.f1"),
      t("services.pk2.f2"),
      t("services.pk2.f3"),
      t("services.pk2.f4"),
      t("services.pk2.f5"),
    ],
    star: t("services.pk2.star"),
    mid: true,
  },
  {
    ghost: "7000",
    no: `${t("services.pk.package")} 03`,
    name: t("services.pk3.name"),
    sub: t("services.pk3.sub"),
    price: t("services.pk3.price"),
    range: t("services.pk3.range"),
    feats: [
      t("services.pk3.f1"),
      t("services.pk3.f2"),
      t("services.pk3.f3"),
      t("services.pk3.f4"),
      t("services.pk3.f5"),
    ],
    star: null,
    mid: false,
  },
];

const extras = [
  { title: t("services.extra.x1t"), desc: t("services.extra.x1p") },
  { title: t("services.extra.x2t"), desc: t("services.extra.x2p") },
  { title: t("services.extra.x3t"), desc: t("services.extra.x3p") },
];
---

<section id="services" class="of" aria-label={label}>
  <script is:inline>
    // Bez JS sekcja zostaje w pełni widoczna (fallback SEO); klasa .js
    // uzbraja stany startowe animacji (patrz media no-preference niżej).
    document.currentScript?.closest("section")?.classList.add("js");
  </script>

  <!-- chrome sekcji -->
  <div class="of-tag">
    <span class="t-num">02</span><span class="t-sl" aria-hidden="true">/</span
    ><span class="t-lbl">{label}</span>
  </div>
  <div class="of-meta" aria-hidden="true">{t("services.meta")}</div>

  <!-- ── INTRO: czytanie scrollem ── -->
  <div class="of-intro">
    <div class="of-ghost" aria-hidden="true">{t("services.ghost")}</div>
    <p class="of-lead of-lit">{t("services.lead1")}</p>
    <p class="of-lead of-lit">
      {t("services.lead2")}
      <span class="acc">{t("services.lead2acc")}</span>
    </p>
    <p class="of-close of-lit">{t("services.close")}</p>
    <div class="of-introhint">
      <div class="of-mono">{t("services.introHint")}</div>
    </div>
  </div>

  <!-- ── PROCES: nić współpracy ── -->
  <div class="of-proces">
    <div class="of-thread" aria-hidden="true"><i class="of-fill"></i></div>

    <ol class="of-steps">
      {
        steps.map((s) => (
          <li class="of-step">
            <span class="of-node" aria-hidden="true" />
            <div class="of-ghostd" aria-hidden="true">
              {s.digit}
            </div>
            <article>
              <div class="st-kick">{s.kick}</div>
              <h3>{s.head}</h3>
              <p>{s.para}</p>
            </article>
          </li>
        ))
      }
    </ol>

    <div class="of-endcap">
      <span class="of-dia" aria-hidden="true"></span>
      <a class="of-cta" href="#packages"
        >{t("services.cta")} <span class="arr" aria-hidden="true">↓</span></a
      >
    </div>
  </div>

  <!-- ── PAKIETY: P4 ghost-ceny (statyczne, tylko hover) ── -->
  <div id="packages">
    <div class="pk-head">
      <div>
        <div class="of-mono kick">{t("services.pk.kick")}</div>
        <h2>
          {t("services.pk.headLead")}
          <span class="sf">{t("services.pk.headAccent")}</span>
        </h2>
      </div>
    </div>

    <div class="pk-grid">
      {
        packages.map((pk) => (
          <div class:list={["pk-col", { mid: pk.mid }]}>
            <div class="pk-ghost" aria-hidden="true">
              {pk.ghost}
            </div>
            {pk.star && <span class="pk-star">{pk.star}</span>}
            <div class="pk-no">{pk.no}</div>
            <h3 class="pk-name">{pk.name}</h3>
            <div class="pk-sub">{pk.sub}</div>
            <div class="pk-price">
              <span class="od">{t("services.pk.from")}</span>
              <span class="val">{pk.price}</span>
              <span class="net">{t("services.pk.net")}</span>
            </div>
            <span class="pk-range">{pk.range}</span>
            <ul class="pk-feats">
              {pk.feats.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
            <a class="pk-cta" href="#contact">
              <span class="lbl">{t("services.pk.cta")}</span>
              <span class="arr" aria-hidden="true">
                →
              </span>
            </a>
          </div>
        ))
      }
    </div>

    <div class="pk-dedy">
      <div class="dcol">
        <div class="of-mono">{t("services.dedy.kick")}</div>
        <div class="dname">{t("services.dedy.name")}</div>
        <div class="dsub">{t("services.dedy.sub")}</div>
      </div>
      <p class="ddesc">{t("services.dedy.desc")}</p>
      <div class="dright">
        <span class="dprice">{t("services.dedy.price")}</span>
        <a class="dlink" href="#contact"
          >{t("services.dedy.link")}
          <span class="arr" aria-hidden="true">→</span></a
        >
      </div>
    </div>

    <div class="pk-extra">
      <div class="of-mono xkick">{t("services.extra.kick")}</div>
      <div class="xgrid">
        {
          extras.map((x) => (
            <div class="xitem">
              <span class="plus" aria-hidden="true">
                +
              </span>
              <div>
                <div class="xt">{x.title}</div>
                <div class="xp">{x.desc}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- progres procesu (desktop; fixed do viewportu — czysto wizualny) -->
  <div class="of-progress" aria-hidden="true">
    <div class="ticks">
      <i class="on"></i><i></i><i></i><i></i><i></i>
    </div>
    <span class="pcount">01 / 05</span>
  </div>
</section>

<script>
  // Animacje tylko przy dozwolonym ruchu — ta sama bramka co Lenis
  // w BaseLayout; przy reduce statyczny układ realizuje czysty CSS.
  if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    import("./services-scroll").then((m) => m.initServicesScroll());
  }

  // Kotwice CTA sekcji (#packages, #contact): skok jak w navbarze
  // (Lenis immediate + podmiana hash), fallback natywny gdy Lenisa nie ma.
  for (const a of document.querySelectorAll<HTMLAnchorElement>(
    '#services a[href^="#"]',
  )) {
    a.addEventListener("click", (e) => {
      const id = a.getAttribute("href")?.slice(1);
      const target = id ? document.getElementById(id) : null;
      if (!target) return;
      e.preventDefault();
      if (window.__lenis) {
        window.__lenis.scrollTo(target, { offset: 0, immediate: true });
      } else {
        target.scrollIntoView({ behavior: "auto", block: "start" });
      }
      history.replaceState(null, "", `#${id}`);
    });
  }
</script>

<style>
  /* ═══ Sekcja „Oferta" — wartości „zamrożone" z prototypu referencji:
     breakpoint 861px · intro scrub 0.45/0.4 · nić scrub 0.5/0.4 ·
     progi kroków 76/56% (mobile 84/66%) · parallax cyfr ±70px.
     Paleta/fonty z tokenów projektu (global.css); tło sekcji lokalne.
     UWAGA: breakpointy @media (861px) MUSZĄ być równe SERVICES_DESKTOP_MIN_PX
     (services-config.ts) — @media nie umie czytać var(), stąd literały. ═══ */
  .of {
    --of-glow: 255, 90, 71; /* rgb akcentu do poświat (box-shadow rgba) */
    --of-step-gap: 150px; /* pion między krokami procesu (desktop) */
    --of-ghostd-size: 440px; /* cyfry-ghost przy krokach */
    --of-thread-top: 118px; /* start nici pod kickerem intro */
    --of-thread-bottom: 235px; /* koniec nici nad endcapem */
    position: relative;
    overflow: hidden; /* ghost-typografia nie może rozpychać strony w poziomie */
    color: var(--ink);
    font-family: var(--font-body), sans-serif;
  }
  /* Tło sekcji: przezroczyste — widać globalny ambient (bg-stage, wariant
     red) sterowany crossfadem. Lokalna atmosfera (bloby + mesh) usunięta. */
  .of a {
    text-decoration: none;
  }

  /* ── chrome sekcji ── */
  .of-tag {
    position: absolute;
    left: 150px;
    top: 95px;
    z-index: 9;
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-family: var(--font-mono), monospace;
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }
  .of-tag .t-num {
    color: var(--accent);
  }
  .of-tag .t-sl {
    color: var(--faint);
  }
  .of-tag .t-lbl {
    color: var(--muted);
  }
  .of-meta {
    position: absolute;
    right: 150px;
    top: 97px;
    z-index: 9;
    font-family: var(--font-mono), monospace;
    font-size: 11px;
    letter-spacing: 0.26em;
    color: var(--faint);
    text-transform: uppercase;
  }

  /* mono etykieta + diament */
  .of-mono {
    font-family: var(--font-mono), monospace;
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .of-dia {
    display: inline-block;
    width: 11px;
    height: 11px;
    background: var(--accent);
    box-shadow: 0 0 18px rgba(var(--of-glow), 0.7);
    transform: rotate(45deg);
  }

  /* ═══ INTRO — czytanie scrollem ═══ */
  .of-intro {
    position: relative;
    z-index: 6;
    padding: 235px 150px 170px;
  }
  .of-ghost {
    position: absolute;
    left: 118px;
    top: 128px;
    z-index: -1;
    pointer-events: none;
    user-select: none;
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    font-size: clamp(170px, 17.5vw, 340px);
    line-height: 0.82;
    letter-spacing: -0.045em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(245, 240, 236, 0.09);
  }
  .of-lead {
    margin: 0 0 46px;
    max-width: 1480px;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: clamp(30px, 2.35vw, 43px);
    line-height: 1.32;
    text-wrap: pretty;
    color: var(--ink);
  }
  /* :global — spany .of-w/.acc tworzy w runtime services-scroll.ts (split),
     więc nie dostają atrybutu scopingu Astro. */
  .of-lead :global(.acc) {
    color: var(--accent);
  }
  .of-close {
    margin: 0;
    max-width: 900px;
    font-weight: 400;
    font-size: 22px;
    line-height: 1.55;
    color: var(--ink);
  }
  .of-introhint {
    margin-top: 96px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
  }

  /* ═══ PROCES — nić ═══ */
  .of-proces {
    position: relative;
    z-index: 6;
    padding: 40px 150px 60px;
  }
  .of-thread {
    position: absolute;
    left: 50%;
    top: var(--of-thread-top);
    bottom: var(--of-thread-bottom);
    width: 2px;
    margin-left: -1px;
    z-index: 4;
    background: var(--line);
  }
  .of-fill {
    position: absolute;
    inset: 0;
    transform-origin: 50% 0;
    will-change: transform;
    background: linear-gradient(180deg, rgba(255, 90, 71, 0.25), var(--accent));
    box-shadow: 0 0 18px rgba(var(--of-glow), 0.45);
  }
  .of-steps {
    list-style: none;
    margin: 96px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--of-step-gap);
  }
  .of-step {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .of-step article {
    grid-column: 1;
    justify-self: end;
    text-align: right;
    width: min(640px, 100%);
    padding-right: 110px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 15px;
  }
  .of-step:nth-child(even) article {
    grid-column: 2;
    justify-self: start;
    text-align: left;
    align-items: flex-start;
    padding-right: 0;
    padding-left: 110px;
  }
  .of-step .st-kick {
    font-family: var(--font-mono), monospace;
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--faint);
    text-transform: uppercase;
    transition: color 0.45s;
  }
  .of-step.lit .st-kick {
    color: var(--accent);
  }
  .of-step h3 {
    margin: 0;
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    font-size: clamp(34px, 2.5vw, 47px);
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
  }
  .of-step p {
    margin: 0;
    max-width: 530px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
  }
  .of-node {
    position: absolute;
    left: 50%;
    top: 4px;
    width: 13px;
    height: 13px;
    z-index: 5;
    transform: translateX(-50%) rotate(45deg);
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--line);
    transition:
      background 0.5s,
      box-shadow 0.5s;
  }
  .of-step.lit .of-node {
    background: var(--accent);
    box-shadow: 0 0 22px rgba(var(--of-glow), 0.75);
  }
  .of-ghostd {
    position: absolute;
    top: -70px;
    z-index: -1;
    pointer-events: none;
    user-select: none;
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    font-size: var(--of-ghostd-size);
    line-height: 0.82;
    letter-spacing: -0.045em;
    color: transparent;
    -webkit-text-stroke: 2px rgba(245, 240, 236, 0.1);
  }
  .of-step:nth-child(odd) .of-ghostd {
    right: 70px;
  }
  .of-step:nth-child(even) .of-ghostd {
    left: 70px;
  }

  /* zakończenie nici + CTA */
  .of-endcap {
    position: relative;
    z-index: 6;
    margin-top: 150px;
    padding-bottom: 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
    text-align: center;
  }
  .of-cta {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 12px;
    font-weight: 600;
    font-size: 21px;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .of-cta:hover {
    color: var(--ink);
  }
  .of-cta .arr {
    color: var(--accent);
    transition: transform 0.25s;
  }
  .of-cta:hover .arr {
    transform: translateY(4px);
  }

  /* progres (desktop, fixed przy krawędzi; włącza klasa of-prog-on NA SEKCJI) */
  .of-progress {
    position: fixed;
    left: 56px;
    bottom: 44px;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 18px;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.4s,
      transform 0.4s;
    pointer-events: none;
  }
  .of.of-prog-on .of-progress {
    opacity: 1;
    transform: none;
  }
  .of-progress .ticks {
    display: flex;
    gap: 7px;
  }
  .of-progress .ticks i {
    width: 26px;
    height: 2px;
    background: var(--line);
    transition: background 0.3s;
  }
  .of-progress .ticks i.on {
    background: var(--accent);
  }
  .of-progress .pcount {
    font-family: var(--font-mono), monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  /* ═══ PAKIETY — P4 ghost-ceny (statyczne, tylko hover) ═══ */
  #packages {
    position: relative;
    z-index: 6;
    padding: 170px 150px 160px;
  }
  .pk-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 130px;
  }
  .pk-head .kick {
    color: var(--accent);
    margin-bottom: 20px;
  }
  .pk-head h2 {
    margin: 0;
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    font-size: clamp(56px, 4.4vw, 84px);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--ink);
  }
  .pk-head h2 .sf {
    font-family: var(--font-serif), serif;
    font-style: italic;
    font-weight: 400;
    font-size: 1.06em;
    letter-spacing: 0;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .pk-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    /* węższa szczelina = szersze karty */
    gap: 40px;
  }
  .pk-col {
    position: relative;
    border-top: 2px solid rgba(245, 240, 236, 0.3);
    /* Wypełniona karta: oddech po bokach; dół = odstęp CTA→divider nad nim
       (.pk-cta padding-top 20px), by domknięcie było symetryczne. */
    padding: 165px 24px 20px;
    /* Solidne tło sekcji sprzed ambientu — karta „na tle ambientu”. */
    background: #070507;
    transition: transform 0.35s ease;
  }
  .pk-col:hover {
    transform: translateY(-6px);
  }
  .pk-ghost {
    position: absolute;
    left: 0;
    top: 24px;
    pointer-events: none;
    user-select: none;
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    font-size: clamp(96px, 7.6vw, 148px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 2px rgba(245, 240, 236, 0.13);
    transition: -webkit-text-stroke-color 0.35s;
  }
  .pk-col:hover .pk-ghost {
    -webkit-text-stroke-color: rgba(245, 240, 236, 0.26);
  }
  .pk-col.mid {
    border-top-color: var(--accent);
  }
  .pk-col.mid .pk-ghost {
    -webkit-text-stroke-color: rgba(255, 90, 71, 0.38);
  }
  .pk-col.mid:hover .pk-ghost {
    -webkit-text-stroke-color: rgba(255, 90, 71, 0.6);
  }
  .pk-star {
    position: absolute;
    right: 8px;
    top: 32px;
    font-family: var(--font-mono), monospace;
    font-size: 9.5px;
    letter-spacing: 0.24em;
    color: var(--accent);
    text-transform: uppercase;
  }
  .pk-no {
    font-family: var(--font-mono), monospace;
    font-size: 10px;
    letter-spacing: 0.3em;
    color: var(--faint);
    text-transform: uppercase;
  }
  .pk-name {
    margin: 12px 0 0;
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    font-size: 40px;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .pk-sub {
    margin: 4px 0 0;
    font-family: var(--font-serif), serif;
    font-style: italic;
    font-size: 20px;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .pk-price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 24px;
  }
