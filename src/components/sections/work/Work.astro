---
import { getCollection } from "astro:content";
import { useTranslations, type Lang } from "@/i18n/utils";
import { WORK_INDEX_PATH } from "@/lib/routes";
import { localizeProject } from "./work-data";
import WorkCard from "./WorkCard.astro";
import WorkCarousel from "./WorkCarousel.astro";
import WorkMoreButton from "./WorkMoreButton.astro";
import WorkDetail from "./WorkDetail.astro";
import Modal from "@/components/ui/Modal.astro";
import BottomSheet from "@/components/ui/BottomSheet.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const entries = await getCollection("realizacje");
// Strona główna pokazuje TYLKO pierwsze 3 realizacje (wg `order`). Pełna
// lista żyje na podstronie /realizacje/ (przycisk „Więcej realizacji").
const projects = entries
  .map((e) => e.data)
  .sort((a, b) => a.order - b.order)
  .map((p) => localizeProject(p, lang))
  .slice(0, 3);

const moreHref = WORK_INDEX_PATH[lang];
---

<section id="work" class="work">
  <header class="work__head">
    <p class="work__eyebrow">
      <span class="work__eyebrow-num">03</span><span
        class="work__eyebrow-sl"
        aria-hidden="true">/</span
      ><span class="work__eyebrow-lbl">{t("work.eyebrow")}</span>
    </p>
    <h2 class="work__title">
      {t("work.headlineLead")}{" "}
      <span class="work__accent">{t("work.headlineAccent")}</span>
    </h2>
  </header>

  {
    /* Desktop (≥761px): naprzemienne kafle + kafel „Więcej realizacji" pod spodem. */
  }
  <div class="work__desktop">
    <div class="work__gallery">
      {
        projects.map((project, i) => (
          <WorkCard project={project} index={i} cta={t("work.cta")} />
        ))
      }
    </div>
    <div class="work__more-wrap">
      <WorkMoreButton variant="tile" href={moreHref} label={t("work.more")} />
    </div>
  </div>

  {
    /* Mobile (≤760px): pozioma karuzela z kafelkiem „Więcej" jako ostatni slajd. */
  }
  <WorkCarousel
    projects={projects}
    cta={t("work.cta")}
    moreHref={moreHref}
    moreBig={t("work.moreBig")}
    moreSub={t("work.moreSub")}
    moreLabel={t("work.more")}
    prevLabel={t("work.prev")}
    nextLabel={t("work.next")}
    gotoLabel={t("work.goto")}
  />

  {/* Treść szczegółów per realizacja — klonowana do nakładki po kliknięciu. */}
  {
    projects.map((project) => (
      <template data-work-detail={project.slug}>
        <WorkDetail
          project={project}
          previewLabel={t("work.preview")}
          resultsLabel={t("work.results")}
          scopeLabel={t("work.scope")}
          liveLabel={t("work.live")}
        />
      </template>
    ))
  }

  <Modal id="work-modal" closeLabel={t("work.close")}>
    <div data-work-host></div>
  </Modal>
  <BottomSheet id="work-sheet" closeLabel={t("work.close")}>
    <div data-work-host></div>
  </BottomSheet>
</section>

<script>
  // Galeria desktopowa: klik w kafel → Modal z WorkDetail (współdzielony helper).
  // Karuzela mobilna ma własną obsługę tapnięcia (WorkCarousel.astro).
  import { openWorkDetail, sheetMQ } from "./open-detail";

  const gallery = document.querySelector<HTMLElement>(".work__gallery");
  gallery?.addEventListener("click", (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>(
      "[data-work-slug]",
    );
    if (!card) return;
    const slug = card.dataset.workSlug;
    if (!slug) return;
    openWorkDetail(slug, card.dataset.workName ?? "");
  });

  // Zmiana progu (modal ↔ sheet) przy otwartej nakładce: zamknij, by nie
  // zostawić niespójnego stanu między wariantami.
  sheetMQ.addEventListener("change", () => {
    if (!window.overlay?.isOpen()) return;
    window.overlay.close("work-modal");
    window.overlay.close("work-sheet");
  });
</script>

<style>
  .work {
    position: relative;
    /* granica z ramką About (ramka dokłada 0) */
    padding-bottom: var(--section-gap);
    color: var(--ink);
  }

  .work__head {
    text-align: center;
    /* góra = połowa tokenu (druga połowa siedzi w .of-intro sekcji Oferta) */
    padding: calc(var(--section-gap) / 2) 5vw 8px;
  }
  .work__eyebrow {
    margin: 0 0 22px;
    font-family: var(--font-mono), monospace;
    font-size: 12px;
    letter-spacing: 0.42em;
    text-indent: 0.42em;
    text-transform: uppercase;
    color: var(--faint);
  }
  /* Numer + slash (jak tag w O Mnie) — tylko na mobile */
  .work__eyebrow-num,
  .work__eyebrow-sl {
    display: none;
  }
  .work__title {
    margin: 0;
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    font-size: clamp(46px, 8vw, 104px);
    color: var(--ink);
    text-wrap: balance;
  }
  .work__accent {
    display: block;
    padding-bottom: 0.06em;
    font-family: var(--font-serif), serif;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .work__gallery {
    display: flex;
    flex-direction: column;
    gap: 140px;
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(48px, 6vw, 90px) 6vw 0;
  }

  /* Kafel „Więcej realizacji" pod galerią (desktop). */
  .work__more-wrap {
    display: flex;
    justify-content: center;
    margin-top: clamp(64px, 8vw, 110px);
    padding: 0 6vw;
  }

  /* Desktop pokazuje galerię + kafel; mobile — tylko karuzelę. */
  @media (max-width: 760px) {
    .work__desktop {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .work__head {
      padding: calc(var(--section-gap) / 2) 24px 6px;
    }
    .work__eyebrow {
      display: flex;
      align-items: baseline;
      gap: 14px;
      margin-bottom: 16px;
      font-size: 12px;
      letter-spacing: 0.3em;
      text-indent: 0;
      text-align: left;
    }
    .work__eyebrow-num {
      display: inline;
      color: var(--accent);
    }
    .work__eyebrow-sl {
      display: inline;
      color: var(--faint);
    }
    .work__eyebrow-lbl {
      color: var(--muted);
    }
    .work__title {
      font-size: 42px;
      letter-spacing: -0.03em;
      line-height: 1.02;
    }
    .work__accent {
      display: inline;
    }
  }
</style>
