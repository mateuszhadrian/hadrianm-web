---
// Para CTA sekcji „Oferta" — port referencji docs/design/export-buttony-oferta/
// na tokeny projektu (docs/analiza-podstrony-oferta.md, D8). Primary
// „Przeglądaj pakiety" = wspólny AnimatedCta (skórka banera Kontakt:
// kremowy fill + sheen/puls/ring na desktopie — poprawka 2
// docs/visual-corrections-part1.md) + secondary „Proces współpracy" =
// wspólny SplitCta (panel split z podpisem mono; skórka wydzielona dla
// kart huba /oferta/ — analiza-podstrona-oferta-hub.md). Obok siebie na
// desktop → słupek na mobile; próg = szerokość KONTENERA (container query),
// więc układa się poprawnie w dowolnej sekcji. Etykiety podaje strona
// (i18n), strzałki są dekoracją.
import AnimatedCta from "@/components/ui/AnimatedCta.astro";
import SplitCta from "@/components/ui/SplitCta.astro";

interface Props {
  /** Adres CTA primary (Przeglądaj pakiety). */
  packagesHref: string;
  /** Etykieta CTA primary. */
  packagesLabel: string;
  /** Adres CTA secondary (Proces współpracy). */
  processHref: string;
  /** Etykieta CTA secondary. */
  processLabel: string;
  /** Podpis mono pod etykietą secondary (pusty = ukryty). */
  processSub?: string;
  /** Dodatkowe klasy na kontenerze — np. do pozycjonowania. */
  class?: string;
}

const {
  packagesHref,
  packagesLabel,
  processHref,
  processLabel,
  processSub,
  class: className = "",
} = Astro.props;
---

<div class:list={["pp-cta-wrap", className]}>
  <div class="pp-cta">
    {
      /* Klasa pp-btn--solid zostaje jako czysty hook DOM (e2e services.spec,
         services-subpages.spec) — skórka i animacje żyją w AnimatedCta. */
    }
    <AnimatedCta
      class="pp-btn--solid"
      href={packagesHref}
      label={packagesLabel}
    />

    <SplitCta href={processHref} label={processLabel} sub={processSub} />
  </div>
</div>

<style>
  /* kontener reaguje na własną szerokość */
  .pp-cta-wrap {
    container-type: inline-size;
  }

  .pp-cta {
    display: flex;
    align-items: stretch;
    gap: 18px;
    max-width: 760px;
  }
  /* :global — rooty komponentów AnimatedCta/SplitCta nie dostają atrybutu
     scopingu Astro; para dzieli szerokość po równo jak dotąd. */
  .pp-cta > :global(.pp-btn),
  .pp-cta > :global(.animated-cta) {
    flex: 1;
  }

  /* ── MOBILE — słupek, pełna szerokość, primary na górze.
     Próg = szerokość kontenera (nie viewportu). ── */
  @container (max-width: 640px) {
    .pp-cta {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      max-width: none;
    }
  }
</style>
