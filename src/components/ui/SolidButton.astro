---
// Sekcyjny button „Więcej o mnie" (Solid jasny) — port referencji
// docs/design/"Button - Wiecej o mnie (D5 + MB) - Eksport.html" na tokeny
// projektu: mobile-first wariant MB (pełna szerokość), od 861px wariant D5
// (auto-szerokość). Prowadzi ze statycznej zajawki sekcji na jej podstronę
// (plan: docs/analiza-podstrona-o-mnie.md).
interface Props {
  href: string;
  label: string;
  class?: string;
}
const { href, label, class: className } = Astro.props;
---

<a href={href} class:list={["solid-button", className]}>
  <span class="solid-button__label">{label}</span>
  <span class="solid-button__arrow" aria-hidden="true">→</span>
</a>

<style>
  /* ── MB · Pełna szerokość (baza mobile) ── */
  .solid-button {
    /* atrament na jasnym wypełnieniu bez odpowiednika w tokenach — lokalnie
       (referencja: --btn-fg; wypełnienie #F5F0EC = globalny --ink) */
    --solid-ink: #180a08;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 12px;
    padding: 17px 20px;
    border-radius: 10px;

    background: var(--ink);
    color: var(--solid-ink);
    font-family: var(--font-body), sans-serif;
    font-weight: 700;
    font-size: 16px;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;

    box-shadow: 0 16px 40px -22px rgba(0, 0, 0, 0.8);
    transition:
      transform 0.18s,
      box-shadow 0.25s,
      background 0.25s;
  }

  .solid-button__arrow {
    color: var(--accent);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .solid-button:hover {
    background: #fff;
  }
  .solid-button:hover .solid-button__arrow {
    transform: translateX(4px);
  }
  .solid-button:active {
    transform: translateY(1px);
  }
  .solid-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* ── D5 · Solid jasny (desktop) — 861px = ABOUT_DESKTOP_MIN_PX
     (kontrakt @media ↔ about-config.ts, jak w całej sekcji) ── */
  @media (min-width: 861px) {
    .solid-button {
      width: auto;
      justify-content: flex-start;
      padding: 16px 26px;
      border-radius: 6px;
      letter-spacing: 0.005em;
      box-shadow: 0 16px 44px -20px rgba(0, 0, 0, 0.75);
      transition:
        transform 0.25s,
        box-shadow 0.25s,
        background 0.25s;
    }
    .solid-button:hover {
      transform: translateY(-1px);
      box-shadow: 0 22px 54px -22px rgba(0, 0, 0, 0.85);
    }
    .solid-button:active {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .solid-button,
    .solid-button__arrow {
      transition: none;
    }
  }
</style>
