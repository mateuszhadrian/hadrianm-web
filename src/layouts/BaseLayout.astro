---
import "@fontsource-variable/archivo/index.css";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";

// Fonty strony drewelomet (ekran laptopa w Hero). Pliki woff2 ściągają się
// dopiero gdy realnie użyte — LaptopSite renderuje się tylko na desktop/tablet,
// więc na mobile dochodzą tu jedynie reguły @font-face (bez pobrań).
import "@fontsource/saira-condensed/latin-600.css";
import "@fontsource/saira-condensed/latin-ext-600.css";
import "@fontsource/space-mono/latin-400.css";

import "@/styles/global.css";

interface Props {
  title?: string;
  lang?: string;
}
const { title = "hadrianm.pl — pracownia stron i aplikacji", lang = "pl" } =
  Astro.props;

// Adresy absolutne dla podglądów linków (iMessage/Messenger/X wymagają pełnego URL).
// W dev bazą jest bieżący host (np. adres w sieci lokalnej), by podgląd linka
// działał przed deployem; w buildzie produkcyjnym — domena z astro.config.
// og-image.png = kwadratowy screenshot pierwszego widoku strony (wersja EN);
// bez og:image iMessage sam wybierał duży obrazek ze strony (tło drewelomet).
const urlBase = import.meta.env.DEV ? Astro.url : Astro.site;
const canonicalUrl = new URL(Astro.url.pathname, urlBase);
const ogImageUrl = new URL("/og-image.png", urlBase);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#000000" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="hadrianm.pl" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:locale" content={lang === "pl" ? "pl_PL" : "en_US"} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonicalUrl} />
  </head>
  <body>
    <slot />
    <script>
      // Lenis ładowany dynamicznie przy dozwolonym ruchu (config dobiera sam).
      if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
        import("@/scripts/smooth-scroll");
      }
    </script>
  </body>
</html>
