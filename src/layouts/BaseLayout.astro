---
import "@fontsource-variable/archivo/index.css";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";

// Fonty strony drewelomet (ekran laptopa w Hero). Pliki woff2 ściągają się
// dopiero gdy realnie użyte — LaptopSite renderuje się tylko na desktop/tablet,
// więc na mobile dochodzą tu jedynie reguły @font-face (bez pobrań).
import "@fontsource/saira-condensed/latin-600.css";
import "@fontsource/saira-condensed/latin-ext-600.css";
import "@fontsource/space-mono/latin-400.css";

import "@/styles/global.css";

import Toast from "@/components/ui/toast/Toast.astro";

// Preload krojów above-the-fold — skraca okno font-display:swap (mniejszy
// „przeskok" z fontu systemowego przy nawigacji). Import ?url zamiast
// hardkodu: hash pliku woff2 zmienia się co build. Zestaw z audytu
// (docs/visual-corrections-part1.md pkt 8): Archivo latin wszędzie;
// Instrument Serif TYLKO italic (repo nie używa odmiany prostej — wszystkie
// akcenty .sf/em mają font-style: italic); subsety latin-ext tylko na PL
// (polskie diakrytyki w tekście i akcentach; EN jest czystym latin).
import archivoWoff2 from "@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url";
import archivoExtWoff2 from "@fontsource-variable/archivo/files/archivo-latin-ext-wght-normal.woff2?url";
import serifItalicWoff2 from "@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url";
import serifItalicExtWoff2 from "@fontsource/instrument-serif/files/instrument-serif-latin-ext-400-italic.woff2?url";

interface Props {
  title?: string;
  lang?: string;
  /** Opcjonalny meta description (podstrony; strona główna go nie ustawia). */
  description?: string;
  /** Pary hreflang → ścieżka (np. { pl: "/realizacje/", en: "/en/projects/" }). */
  alternates?: Record<string, string>;
  /** false = podstrona bez Lenisa (scroll natywny) — patrz
   *  docs/analiza-podstrona-realizacje.md (D1). "desktop" = Lenis tylko
   *  na urządzeniach bez dotyku (podstrona /dla-kogo/: desktopowy
   *  scrub+snap na Lenisie, mobile natywnie — same reveale once:true;
   *  docs/analiza-podstrona-dla-kogo.md §VII). */
  smoothScroll?: boolean | "desktop";
}
const {
  title = "hadrianm.pl — pracownia stron i aplikacji",
  lang = "pl",
  description,
  alternates,
  smoothScroll = true,
} = Astro.props;

const smoothScrollAttr =
  smoothScroll === "desktop" ? "desktop" : smoothScroll ? "on" : "off";

// Adresy absolutne dla podglądów linków (iMessage/Messenger/X wymagają pełnego URL).
// W dev bazą jest bieżący host (np. adres w sieci lokalnej), by podgląd linka
// działał przed deployem; w buildzie produkcyjnym — domena z astro.config.
// og-image.png = kwadratowy screenshot pierwszego widoku strony (wersja EN);
// bez og:image iMessage sam wybierał duży obrazek ze strony (tło drewelomet).
const urlBase = import.meta.env.DEV ? Astro.url : Astro.site;
const canonicalUrl = new URL(Astro.url.pathname, urlBase);
const ogImageUrl = new URL("/og-image.png", urlBase);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#000000" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={archivoWoff2}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={serifItalicWoff2}
      crossorigin
    />
    {
      lang === "pl" && (
        <>
          <link
            rel="preload"
            as="font"
            type="font/woff2"
            href={archivoExtWoff2}
            crossorigin
          />
          <link
            rel="preload"
            as="font"
            type="font/woff2"
            href={serifItalicExtWoff2}
            crossorigin
          />
        </>
      )
    }
    <script is:inline>
      // Mikro-fade przy nawigacji WEWNĘTRZNEJ (docs/visual-corrections-part1.md
      // pkt 8): pierwsza wizyta w karcie (brak flagi sessionStorage) renderuje
      // się bez żadnej bramki — zero wpływu na LCP (LHCI i Playwright wchodzą
      // na zimno). Przy kolejnych nawigacjach treść wjeżdża krótkim fade'em
      // zdejmowanym przez document.fonts.ready LUB twardy timeout 300 ms —
      // strona nigdy nie zostaje ukryta (błąd JS/brak JS = brak klasy
      // nav-fade, czyli domyślnie widoczna).
      (() => {
        try {
          const KEY = "hm:visited";
          const revisit = sessionStorage.getItem(KEY) === "1";
          sessionStorage.setItem(KEY, "1");
          if (!revisit) return;
          const root = document.documentElement;
          root.classList.add("nav-fade");
          const reveal = () => root.classList.add("fonts-in");
          setTimeout(reveal, 300);
          if (document.fonts && document.fonts.ready)
            document.fonts.ready.then(reveal, reveal);
        } catch {
          /* sessionStorage niedostępny (tryb prywatny) — bez fade */
        }
      })();
    </script>
    <style is:global>
      /* Bramka mikro-fade — patrz inline skrypt wyżej. Stan bazowy (bez
         .nav-fade) jest w pełni widoczny. */
      html.nav-fade body {
        opacity: 0;
      }
      html.nav-fade.fonts-in body {
        opacity: 1;
        transition: opacity 0.18s ease;
      }
      @media (prefers-reduced-motion: reduce) {
        html.nav-fade.fonts-in body {
          transition: none;
        }
      }
    </style>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {
      alternates &&
        Object.entries(alternates).map(([hl, path]) => (
          <link rel="alternate" hreflang={hl} href={new URL(path, urlBase)} />
        ))
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="hadrianm.pl" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:locale" content={lang === "pl" ? "pl_PL" : "en_US"} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonicalUrl} />
  </head>
  <body data-smooth-scroll={smoothScrollAttr}>
    <slot />
    <Toast />
    <script>
      // Lenis ładowany dynamicznie przy dozwolonym ruchu (config dobiera sam).
      // Podstrony bez animacji scrollowych rezygnują z niego w całości
      // (smoothScroll=false → data-smooth-scroll="off", scroll natywny);
      // tryb "desktop" pomija Lenisa na urządzeniach dotykowych (detekcja
      // maxTouchPoints — kontrakt z .claude/rules/scroll-lenis.md, NIE media
      // queries hover/pointer). Bramka atrybutem, bo skrypt w wyrażeniu
      // Astro traci bundling aliasów.
      const mode = document.body.dataset.smoothScroll;
      if (
        mode !== "off" &&
        !(mode === "desktop" && navigator.maxTouchPoints > 0) &&
        matchMedia("(prefers-reduced-motion: no-preference)").matches
      ) {
        import("@/scripts/smooth-scroll");
      }
    </script>
    <script>
      import { initBackLinks } from "@/scripts/back-link";

      // Linki „wstecz" podstron (a[data-back]) → history.back() zamiast nowej
      // nawigacji — przywraca miejsce scrolla poprzedniej strony (moduł).
      initBackLinks();
    </script>
  </body>
</html>
